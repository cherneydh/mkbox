#!/usr/bin/env bash
# mkbox - create (or re-enter) a per-box workspace and drop into a logged shell.
#
# Usage:  mkbox [-n|--no-shell] <boxname|path> [target-ip]
#         mkbox -c|--clean  <boxname|path>          rebuild the cleaned session log
#         mkbox -r|--report [--creds] <boxname|path> build a report draft + evidence tarball
#         mkbox -p|--pad <box|-g> [edit|add|cmd|show|grep|path]   per-box (or global -g) scratchpad
#         mkbox -l|--list                            list boxes in the current directory
#         mkbox -V|--version                         print the version
#
# The box is created in the CURRENT directory:
#   mkbox lame 10.10.10.3     -> ./lame
#   mkbox .                   -> use the current directory as the box
#   mkbox ~/labs/htb/lame     -> any path works; the last component is the box name
#
# Reports (-r) merge your shell history, timeline notes and screenshot captions into one
# chronological log (GNU date required); `addcred` commands are shown with the password masked.
#
# Logs:   session-<name>.log        cleaned (no escape codes), regenerated on exit; one
#                                   labeled section per session/tab, in start order
#         .sessions/<start>-<pid>.raw   raw `script` output, one file per mkbox invocation
#                                   (so several tabs can be open on the same box safely)

set -euo pipefail

VERSION="1.4.2"

# Where mkbox itself lives, so it can find its bundled templates/ (see --odt) regardless of which
# directory it was invoked from or whether $0 is a symlink.
MKBOX_SCRIPT_DIR="$(cd -- "$(dirname -- "$(readlink -f -- "$0")")" && pwd)"

# Written for bash 4.4+ (empty arrays under `set -u`, associative arrays); developed on 5.2.
if (( BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4) )); then
  echo "mkbox: needs bash 4.4 or newer (this is ${BASH_VERSION%%[( ]*})" >&2
  exit 1
fi

SUBDIRS=(nmap web loot exploits creds notes screenshots transfer)
# Commands that get a start/end note in the timeline (wrapped inside the box shell) and whose
# command lines get password masking in reports. Override it in your environment or ~/.bashrc.
MKBOX_NET_CMDS="${MKBOX_NET_CMDS:-ssh sshpass ftp sftp ncftp lftp smbclient rdesktop xfreerdp remmina nc ncat netcat telnet mysql psql evil-winrm}"
export MKBOX_NET_CMDS
# Accepted target IP/hostname; also exported to the box shell for `setip`. It must not start with
# "-" so a value like "-sV" can never be mistaken for an nmap option later.
IP_RE='^[A-Za-z0-9:][A-Za-z0-9.:-]*$'

# env_get <box_dir> <VAR>: read one variable from box.env ("" if unset or the file is missing)
env_get() {
  [[ -f "$1/box.env" ]] || return 0
  # shellcheck source=/dev/null
  ( . "$1/box.env" 2>/dev/null; printf '%s' "${!2:-}" ) || true
}

# write_env <box_dir> <ip> <ports> <udp_ports> [ad_set 0|1]: rewrite box.env atomically (temp file +
# rename), so a tab that re-reads it at that moment never sees a half-written file. ad_set defaults
# to whatever is already in box.env (so callers that don't know about it, like the only call site
# below, never accidentally clear it).
write_env() {
  local t ad="${5:-$(env_get "$1" AD_SET)}"
  t="$(mktemp "$1/.box.env.XXXXXX")"
  printf 'export IP=%q\nexport PORTS=%q\nexport UDP_PORTS=%q\nexport AD_SET=%q\n' "$2" "$3" "$4" "${ad:-0}" > "$t"
  chmod 644 "$t"
  mv -f "$t" "$1/box.env"
}

usage() {
  cat >&2 <<'U'
Usage: mkbox [-n|--no-shell] <boxname|path> [target-ip] [--ad]
       mkbox -c|--clean  <boxname|path>
       mkbox -r|--report [--creds] <boxname|path>
       mkbox -a|--assemble <outfile.md> [--odt[=template.odt]] [--author="Name"] [--creds] <box1> [box2 ...]
       mkbox -p|--pad <boxname|path|-g> [edit|add TEXT|cmd CMD|show|grep PAT|path]
       mkbox -l|--list
       mkbox -V|--version
U
  exit "${1:-1}"
}

# pad_file <boxname|path|-g>: print the scratchpad path (creating it, mode 600, if needed).
# Per box: <box>/scratchpad.md (outside notes/, so it is never part of the report or evidence
# tarball). Global (-g): ${XDG_DATA_HOME:-~/.local/share}/mkbox/scratchpad.md, shared by all boxes.
pad_file() {
  local t="$1" d f
  if [[ "$t" == "-g" || "$t" == "--global" ]]; then
    f="${XDG_DATA_HOME:-$HOME/.local/share}/mkbox/scratchpad.md"
    ( umask 077; mkdir -p -- "$(dirname -- "$f")" )
  else
    if [[ "$t" == "." || "$t" == */* ]]; then d="$(realpath -m -- "$t")"; else d="$PWD/$t"; fi
    [[ -f "$d/box.env" ]] || { echo "mkbox: no such box: $d (no box.env)" >&2; return 1; }
    f="$d/scratchpad.md"
  fi
  if [[ ! -e "$f" ]]; then
    ( umask 077; printf '# scratchpad\n\nFree-form notes and commands. Not part of the report or evidence tarball.\n\n' > "$f" )
  fi
  printf '%s\n' "$f"
}

# pad_main <boxname|path|-g> [edit|add TEXT|cmd CMD|show|grep PATTERN|path]
pad_main() {
  [[ $# -ge 1 ]] || usage 1
  local f sub ed
  f="$(pad_file "$1")" || return 1
  shift
  sub="${1:-edit}"
  [[ $# -gt 0 ]] && shift
  case "$sub" in
    edit)
      ed="${VISUAL:-${EDITOR:-}}"
      if [[ -z "$ed" ]]; then
        for ed in nano vim vi; do command -v "$ed" >/dev/null 2>&1 && break; ed=""; done
      fi
      [[ -n "$ed" ]] || { echo "mkbox: no editor found - set \$EDITOR (file: $f)" >&2; return 1; }
      # $ed may carry arguments (EDITOR="code -w"), so let the shell split it
      # shellcheck disable=SC2086
      $ed "$f"
      ;;
    add)
      [[ $# -gt 0 ]] || { echo "usage: pad add \"text\"" >&2; return 1; }
      printf -- '- %s  %s\n' "$(date '+%F %T')" "$*" >> "$f"
      ;;
    cmd)
      [[ $# -gt 0 && -n "$*" ]] || { echo "usage: pad cmd <command>   (inside the box shell, a bare 'pad cmd' saves your previous command)" >&2; return 1; }
      # shellcheck disable=SC2016  # the backticks are a literal markdown fence, not a command substitution
      printf -- '- %s\n\n```\n%s\n```\n\n' "$(date '+%F %T')" "$*" >> "$f"
      ;;
    show|cat) cat -- "$f" ;;
    grep)
      [[ $# -gt 0 ]] || { echo "usage: pad grep <pattern>" >&2; return 1; }
      grep -n -i -- "$@" "$f" || true
      ;;
    path) printf '%s\n' "$f" ;;
    *) echo "mkbox: unknown pad command '$sub' (edit, add, cmd, show, grep, path)" >&2; return 1 ;;
  esac
}

# Line-level terminal emulation used by clean_log. For each line it keeps a cursor and applies what
# a terminal would: \r and \b move the cursor and later characters OVERWRITE (nothing is deleted),
# ESC[K erases to end of line, ESC[nC / ESC[nD / ESC[nG move the cursor, ESC[nP deletes, ESC[n@ inserts.
# Colors, window titles, bracketed-paste toggles and other control codes are dropped. This is the
# same overwrite behaviour as `col -b`, plus the erase/cursor sequences readline uses when it
# redraws a line (tab completion, Ctrl-R, history recall). It cannot follow cursor-up redraws of
# lines that wrap across several screen rows.
read -r -d '' CLEAN_PL <<'PERL' || true
use strict; use warnings; no warnings 'utf8';
binmode(STDIN); binmode(STDOUT);
while (my $line = <STDIN>) {
    my $nl = ($line =~ s/\n\z//) ? "\n" : "";
    my $utf8 = utf8::decode($line);          # stays as raw bytes if the line isn't valid UTF-8
    my @b; my $p = 0;
    pos($line) = 0;
    while (pos($line) < length($line)) {
        if ($line =~ /\G\e\[([0-9;?]*)[ -\/]*([\@-~])/gc) {
            my ($arg, $fin) = ($1, $2);
            my $n = ($arg =~ /^(\d+)/) ? $1 : undef;
            if    ($fin eq 'K') {
                my $m = $n // 0;
                if    ($m == 0) { splice(@b, $p) if $p < @b }
                elsif ($m == 1) { for my $i (0 .. $p - 1) { $b[$i] = ' ' if $i < @b } }
                else            { @b = () }
            }
            elsif ($fin eq 'C') { $p += ($n || 1) }
            elsif ($fin eq 'D') { $p -= ($n || 1); $p = 0 if $p < 0 }
            elsif ($fin eq 'G') { $p = ($n || 1) - 1 }
            elsif ($fin eq 'P') { splice(@b, $p, $n || 1) if $p < @b }
            elsif ($fin eq '@') { push @b, ' ' while @b < $p; splice(@b, $p, 0, (' ') x ($n || 1)) }
            elsif ($fin eq 'X') { for my $i ($p .. $p + ($n || 1) - 1) { $b[$i] = ' ' if $i < @b } }
        }
        elsif ($line =~ /\G\e\][^\a\e]*(?:\a|\e\\)/gc) { }
        elsif ($line =~ /\G\e[()][0-9A-Za-z]/gc)         { }
        elsif ($line =~ /\G\e.?/gcs)                     { }
        elsif ($line =~ /\G\r/gc)                        { $p = 0 }
        elsif ($line =~ /\G\x08/gc)                      { $p-- if $p > 0 }
        elsif ($line =~ /\G[\x00-\x07\x0b\x0c\x0e-\x1a\x1c-\x1f\x7f]/gc) { }
        elsif ($line =~ /\G(.)/gcs) {
            push @b, ' ' while @b < $p;
            $b[$p++] = $1;
        }
    }
    my $out = join('', map { defined $_ ? $_ : ' ' } @b);
    $out =~ s/ +\z//;
    utf8::encode($out) if $utf8;
    print $out, $nl;
}
PERL

# Best-effort password masking for command lines, as an awk program. It is used in two places so they
# can never disagree: the report's command timeline (chrono_log) and the live start/end notes that the
# ssh/ftp/... wrappers write to timeline.md (_netmask in the box shell). Only commands whose first word
# is in $MKBOX_NET_CMDS (an optional leading `sudo` is ignored) are touched, and each tool only gets
# the rules that fit it - e.g. `ssh -p 2222` is a port, so it is left alone, while `sshpass -p` is a
# password. The raw session log always has the real command; this only affects what is *reported*.
read -r -d '' MASK_AWK <<'AWK' || true
# mask_after(s, re, sep, skip, tail): for each match of re in s, keep the text up to and including the
# first sep (searched after the first <skip> characters of the match), replace the rest with ***, and
# add <tail>. If the kept part opened a quote that the match closes (-U 'user%pass'), the closing quote
# is added back so the line stays balanced. A match without sep is left alone.
function mask_after(s, re, sep, skip, tail,    out, m, t, last, keep, tl) {
  out = ""
  while (match(s, re) && RLENGTH > 0) {
    m = substr(s, RSTART, RLENGTH)
    t = index(substr(m, skip + 1), sep)
    if (t > 0) {
      keep = substr(m, 1, skip + t)
      last = substr(m, length(m), 1)
      tl = tail
      if ((last == "'" || last == "\"") && index(keep, last) > 0) tl = tl last
      m = keep "***" tl
    }
    out = out substr(s, 1, RSTART - 1) m
    s = substr(s, RSTART + RLENGTH)
  }
  return out s
}
function mask_cmd(cmd,    rest, tool, arg) {
  rest = cmd
  sub(/^[ \t]*(sudo[ \t]+)?/, "", rest)
  tool = rest
  sub(/[ \t].*$/, "", tool)
  sub(/^.*\//, "", tool)
  arg = "('[^']*'|\"[^\"]*\"|[^ \t]+)"            # one shell word, optionally quoted
  if (tool == "serve") {                                         # the box shell's serve helper: --auth user:PASS
    cmd = mask_after(cmd, "--auth=" arg, ":", 0, "")
    cmd = mask_after(cmd, "--auth[ \t]+" arg, ":", 0, "")
    return cmd
  }
  if (index(" " tools " ", " " tool " ") == 0) return cmd

  # every wrapped tool: --password/--pass (with = or a space) and user:pass@ in a URL
  cmd = mask_after(cmd, "--pass(word)?=" arg, "=", 0, "")
  cmd = mask_after(cmd, "--pass(word)?[ \t]+" arg, " ", 0, "")
  cmd = mask_after(cmd, "://[^/@ \t:]*:[^/@ \t]*@", ":", 3, "@")

  if (tool == "sshpass" || tool == "evil-winrm" || tool == "rdesktop" || tool == "ncftp")
    cmd = mask_after(cmd, "[ \t]-p[ \t]+" arg, " ", 3, "")      # -p PASS (for ssh/nc/psql -p is a port: untouched)
  if (tool == "evil-winrm")
    cmd = mask_after(cmd, "[ \t]-H[ \t]+" arg, " ", 3, "")      # NTLM hash
  if (tool == "mysql")
    cmd = mask_after(cmd, "[ \t]-p" arg, "p", 2, "")            # -pPASS (attached; a bare -p just prompts)
  if (tool == "smbclient")
    cmd = mask_after(cmd, "(-U[ \t]*|--user=)" arg, "%", 0, "") # -U user%pass
  if (tool == "xfreerdp" || tool == "remmina")
    cmd = mask_after(cmd, "/g?p(th)?:" arg, ":", 0, "")         # /p:PASS  /pth:HASH  /gp:GATEWAYPASS
  if (tool == "lftp")
    cmd = mask_after(cmd, "-u[ \t]+[^ \t,]+," arg, ",", 3, "")  # -u user,pass
  if (tool == "ncat")
    cmd = mask_after(cmd, "--proxy-auth[= \t]+" arg, ":", 0, "")
  return cmd
}
AWK

# clean_log <raw>: print the raw log as plain text
clean_log() {
  local raw="$1"
  [[ -s "$raw" ]] || return 0
  if command -v perl >/dev/null 2>&1; then
    perl -e "$CLEAN_PL" < "$raw"
  else
    # no perl: just strip escapes and drop \r and backspaces (cruder, doesn't apply overwrites)
    sed -E 's/\x1b\[[0-9;?]*[ -\/]*[@-~]//g; s/\x1b\][^\x07]*\x07//g; s/\x1b[()][A-Za-z0-9]//g; s/\x1b[=>]//g' "$raw" \
      | tr -d '\r' | sed 's/.\x08//g; s/\x08//g'
  fi
}

# build_log <box_dir> <name>: rebuild session-<name>.log from every raw session log,
# oldest first, each under a "===== session <start time> =====" header
build_log() {
  local dir="$1" name="$2" f b tmp
  local files=()
  if [[ -s "$dir/.session-$name.raw" ]]; then      # single-file layout from earlier versions
    files+=("$dir/.session-$name.raw")
  fi
  shopt -s nullglob
  for f in "$dir"/.sessions/*.raw; do
    if [[ -s "$f" ]]; then
      files+=("$f")
    fi
  done
  shopt -u nullglob
  [[ ${#files[@]} -gt 0 ]] || return 0

  tmp="$(mktemp)"
  for f in "${files[@]}"; do
    b="$(basename -- "$f" .raw)"
    if [[ "$b" =~ ^([0-9]{4})([0-9]{2})([0-9]{2})-([0-9]{2})([0-9]{2})([0-9]{2}) ]]; then
      printf '===== session %s-%s-%s %s:%s:%s =====\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" "${BASH_REMATCH[4]}" "${BASH_REMATCH[5]}" "${BASH_REMATCH[6]}"
    else
      printf '===== earlier session =====\n'
    fi
    clean_log "$f"
    echo
  done > "$tmp"
  chmod 600 "$tmp"                                  # it holds everything you typed, passwords included
  mv "$tmp" "$dir/session-$name.log"
}

# list_boxes: show every box (directory containing box.env) under the current directory
list_boxes() {
  local found=0 d n ip done_count
  printf '%-26s %-18s %s\n' "BOX" "TARGET" "PROOF"
  for d in "$PWD"/*/; do
    [[ -f "${d}box.env" ]] || continue
    found=1
    n="$(basename -- "$d")"
    # shellcheck source=/dev/null
    ip="$(. "${d}box.env"; echo "${IP:-}")"
    done_count="$(grep -cE '^- \[[xX]\] (local|proof)\.txt' "${d}notes/notes.md" 2>/dev/null || true)"
    printf '%-26s %-18s %s/2\n' "$n" "${ip:--}" "${done_count:-0}"
  done
  if [[ "$found" -eq 0 ]]; then
    echo "No boxes found in $PWD"
  fi
}

# files_by_mtime <dir> [find-args...]: relative file names under <dir>, oldest first
files_by_mtime() {
  local d="$1"; shift
  find "$d" -type f "$@" -printf '%T@\t%P\n' 2>/dev/null | sort -n | cut -f2-
}

# ordered_screenshots <screenshots_dir>: image names in the order they were taken. Screenshots saved
# with `shot` come first in captions.tsv order (the order they were captured); any other images
# follow, oldest first.
ordered_screenshots() {
  local d="$1" f
  local -A seen=()
  if [[ -f "$d/captions.tsv" ]]; then
    while IFS=$'\t' read -r f _; do
      if [[ -n "$f" && -f "$d/$f" && -z "${seen[$f]:-}" ]]; then
        seen[$f]=1
        printf '%s\n' "$f"
      fi
    done < "$d/captions.tsv"
  fi
  while IFS= read -r f; do
    if [[ -n "$f" && -z "${seen[$f]:-}" ]]; then
      printf '%s\n' "$f"
    fi
  done < <(files_by_mtime "$d" \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.gif' \))
}

# chrono_log <box_dir> <name>: markdown chronological log. Merges shell history (commands), timeline
# notes and screenshot captions by time. Commands run in a code block; notes and screenshots are
# bullets. Prints nothing if there is nothing to merge. Needs GNU date.
#   - trivial commands (ls, cd, pwd, clear, history, exit, note, shot, ...) are left out
#   - `addcred user:pass ...` is shown as `addcred user:***` so passwords never reach the report
chrono_log() {
  local dir="$1" name="$2" t hist tl cap log
  log="$dir/session-$name.log"
  hist="$dir/.bash_history_$name"
  tl="$dir/notes/timeline.md"
  cap="$dir/screenshots/captions.tsv"
  t="$(mktemp -d)"

  # commands: "<epoch>\tC\t<command>"  (multi-line commands are joined with \036)
  if [[ -s "$hist" ]]; then
    # $MASK_AWK supplies mask_cmd(), shared with the live timeline notes (see its comment above)
    awk -v tools="$MKBOX_NET_CMDS" "$MASK_AWK"'
      function flush() {
        if (cmd == "") return
        if (cmd ~ /^[ \t]*(ls|ll|la|cd|pwd|clear|history|exit|logout|boxinfo|boxcd|note|shot|proofshot|pivot|addvuln|setad|cleanlog|proofcmd|markproof|report)([ \t]|$)/) { cmd = ""; return }
        if (match(cmd, /^addcred +[^: ]+:/)) cmd = substr(cmd, 1, RLENGTH) "***"
        cmd = mask_cmd(cmd)
        printf "%s\tC\t%s\n", ep, cmd
        cmd = ""
      }
      /^#[0-9]+$/ { flush(); ep = substr($0, 2); next }
      { if (ep == "") next; cmd = (cmd == "" ? $0 : cmd "\036" $0) }
      END { flush() }
    ' "$hist" > "$t/c.tsv" || true
  fi

  # timeline notes: "<epoch>\tN\t<text>"; screenshot lines are skipped (captions.tsv covers them)
  if [[ -s "$tl" ]]; then
    grep -E '^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}  ' "$tl" 2>/dev/null \
      | grep -vE '^.{21}screenshot ' > "$t/n.txt" || true
    if [[ -s "$t/n.txt" ]]; then
      cut -c1-19 "$t/n.txt" | date -f - +%s 2>/dev/null > "$t/n.ep" || true
      cut -c22- "$t/n.txt" > "$t/n.tx"
      if [[ "$(wc -l < "$t/n.ep")" -eq "$(wc -l < "$t/n.tx")" ]]; then
        paste -d '\t' "$t/n.ep" <(sed 's/^/N\t/' "$t/n.tx") > "$t/n.tsv"
      else
        echo "mkbox: WARNING: couldn't parse one or more timestamps in notes/timeline.md (GNU date required) - timeline notes left out of the report's chronological log; they're still in notes/timeline.md and the evidence tarball" >&2
      fi
    fi
  fi

  # screenshots: "<epoch>\tS\t<file>\t<caption>"
  if [[ -s "$cap" ]]; then
    cut -f2 "$cap" | date -f - +%s 2>/dev/null > "$t/s.ep" || true
    if [[ "$(wc -l < "$t/s.ep")" -eq "$(wc -l < "$cap")" ]]; then
      paste -d '\t' "$t/s.ep" <(awk -F'\t' '{printf "S\t%s\t%s\n", $1, $3}' "$cap") > "$t/s.tsv"
    else
      echo "mkbox: WARNING: couldn't parse one or more timestamps in screenshots/captions.tsv - screenshot captions left out of the report's chronological log; the images and captions are still in the Screenshots section and the evidence tarball" >&2
    fi
  fi

  # connection transcripts: "<epoch>\tT\t<tool>\037<end info>\037<text>" (lines joined with \036). Cut from the
  # cleaned session log between the markers the ssh/ftp/... wrappers print (see _netlog); long ones are
  # shortened to the first and last half of $MKBOX_TRANSCRIPT_LINES lines (default 300, 0 = never).
  if [[ -s "$log" ]]; then
    awk -v max="${MKBOX_TRANSCRIPT_LINES:-300}" '
      function finish(info,    s, e, i, h, cnt, body) {
        s = 1; e = n
        while (s <= e && buf[s] ~ /^[ \t]*$/) s++
        while (e >= s && buf[e] ~ /^[ \t]*$/) e--
        cnt = e - s + 1; body = ""
        if (max > 0 && cnt > max) {
          h = int(max / 2); if (h < 1) h = 1
          for (i = s; i < s + h; i++) body = body (body == "" ? "" : "\036") buf[i]
          body = body "\036[... " (cnt - 2 * h) " lines omitted - the full text is in the session log ...]"
          for (i = e - h + 1; i <= e; i++) body = body "\036" buf[i]
        } else {
          for (i = s; i <= e; i++) body = body (i == s ? "" : "\036") buf[i]
        }
        printf "%s\t%s\037%s\037%s\n", sts, tool, info, body
        active = 0; n = 0
      }
      /^===== session / { if (active) finish("the log ended before the connection did"); next }
      /^\[mkbox >>> [^ ]+ started [0-9-]+ [0-9:]+\]$/ {
        if (active) finish("the log ended before the connection did")
        tool = $3; sts = $5 " " substr($6, 1, 8); sdate = $5; active = 1; n = 0; next
      }
      /^\[mkbox <<< [^ ]+ ended [0-9-]+ [0-9:]+ exit [0-9]+\]$/ {
        if (active) {
          rc = substr($8, 1, length($8) - 1); ets = substr($6, 1, 8)
          if ($5 != sdate) ets = $5 " " ets
          finish("until " ets ", exit " rc)
        }
        next
      }
      active { line = $0; gsub(/\t/, "    ", line); buf[++n] = line }
      END { if (active) finish("the log ended before the connection did") }
    ' "$log" > "$t/t.raw" || true
    if [[ -s "$t/t.raw" ]]; then
      cut -f1 "$t/t.raw" | date -f - +%s 2>/dev/null > "$t/t.ep" || true
      if [[ "$(wc -l < "$t/t.ep")" -eq "$(wc -l < "$t/t.raw")" ]]; then
        paste -d '\t' "$t/t.ep" <(cut -f2- "$t/t.raw" | sed 's/^/T\t/') > "$t/t.tsv"
      else
        echo "mkbox: WARNING: couldn't parse a connection start time in session-$name.log (GNU date required) - connection transcripts left out of the report's chronological log; they're still in the session log" >&2
      fi
    fi
  fi

  cat "$t"/c.tsv "$t"/n.tsv "$t"/s.tsv "$t"/t.tsv 2>/dev/null | sort -s -t $'\t' -k1,1n > "$t/all.tsv" || true
  if [[ -s "$t/all.tsv" ]]; then
    sed 's/\t.*//; s/^/@/' "$t/all.tsv" | date -f - '+%F %T' 2>/dev/null > "$t/when.txt" || true
    if [[ "$(wc -l < "$t/when.txt")" -ne "$(wc -l < "$t/all.tsv")" ]]; then
      echo "mkbox: WARNING: couldn't re-format one or more merged timeline timestamps - the chronological log is incomplete for this run; re-run with \`mkbox -c\`/\`report\` after checking GNU date is installed" >&2
    fi
    if [[ "$(wc -l < "$t/when.txt")" -eq "$(wc -l < "$t/all.tsv")" ]]; then
      paste -d '\t' "$t/when.txt" "$t/all.tsv" | awk -F'\t' '
        function close_block() { if (inblock) { print "```"; print ""; inblock = 0 } }
        {
          when = $1; kind = $3
          text = $0; sub(/^[^\t]*\t[^\t]*\t[^\t]*\t/, "", text)
          if (kind == "C") {
            if (!inblock) { if (bullet) print ""; print "```"; inblock = 1; bullet = 0 }
            gsub(/\036/, "\n    ", text)
            printf "[%s] $ %s\n", when, text
          } else if (kind == "N") {
            close_block(); printf "- **%s** - %s\n", when, text; bullet = 1
          } else if (kind == "T") {
            close_block()
            n = index(text, "\037"); tl = substr(text, 1, n - 1); text = substr(text, n + 1)
            n = index(text, "\037"); info = substr(text, 1, n - 1); body = substr(text, n + 1)
            printf "- **%s** - **[%s session transcript]** (%s)\n", when, tl, info
            if (body != "") {
              gsub(/\036/, "\n", body)
              print ""; print "````text"; print body; print "````"; print ""
              bullet = 0
            } else { print "  _(no output)_"; bullet = 1 }
          } else if (kind == "S") {
            close_block()
            n = index(text, "\t"); file = substr(text, 1, n - 1); c = substr(text, n + 1)
            printf "- **%s** - screenshot `%s`: %s\n", when, file, c; bullet = 1
          }
        }
        END { close_block() }'
    fi
  fi
  rm -rf "$t"
}

# md_filelist <dir>: markdown bullet list of files under <dir>, oldest first
md_filelist() {
  local out
  out="$(files_by_mtime "$1")"
  if [[ -n "$out" ]]; then
    printf '%s\n' "- ${out//$'\n'/$'\n'- }"
  else
    echo "_none_"
  fi
}

# exploit_list <exploits_dir>: exploits/SOURCES.md (addexploit's source/modification log), if any,
# followed by a bullet list of the other files in exploits/, oldest first. SOURCES.md itself is
# left out of that bullet list since its content is already shown above it.
exploit_list() {
  local dir="$1" out
  if [[ -s "$dir/SOURCES.md" ]]; then
    cat "$dir/SOURCES.md"
    echo
  fi
  out="$(files_by_mtime "$dir" ! -name 'SOURCES.md')"
  if [[ -n "$out" ]]; then
    printf '%s\n' "- ${out//$'\n'/$'\n'- }"
  else
    echo "_none_"
  fi
}

# _warn_secrets_keep <cred>: reads "file:lineno:content" (grep -n output) on stdin and re-prints
# only the lines that should count as a real leak, i.e. filters out the `addcred user:pass ...`
# line you typed, which is in the session log by design. That's normally just "does this line
# contain 'addcred '" - but on a narrow terminal, readline redraws a wrapped command across more
# than one screen row, and clean_log's line-based model can't follow that (see its header comment).
# The observed result is always the same shape: the credential itself (and anything after it)
# survives on its own physical line intact, with only some trailing suffix of the word "addcred"
# still attached before it - "ddcred bob:pass ...", "d bob:pass ...", or nothing at all (with
# no usable terminal width, readline also prefixes a "<" scroll marker: "<ddcred bob:pass"). So a line
# also doesn't count if everything before the credential, once trimmed, is itself such a suffix.
_warn_secrets_keep() {
  local cred="$1" file lineno content before
  while IFS=: read -r file lineno content; do
    case "$content" in *'addcred '*) continue ;; esac
    before="${content%%"$cred"*}"
    before="${before%"${before##*[![:space:]]}"}"            # rtrim trailing whitespace
    before="${before#<}"                                      # readline's "line is scrolled" marker, e.g. "<ddcred"
    [[ "addcred" == *"$before" ]] && continue                 # "", d, ed, red, cred, dcred, ddcred, addcred
    printf '%s:%s\n' "$file" "$lineno"
  done
}

# warn_secrets <box_dir> <path>...: warn if a password recorded in creds/creds.txt also appears in
# the given files or folders (relative to the box). Passwords under 4 characters are skipped. The
# `addcred user:pass` line you typed is in the session log by design, so it doesn't count (see
# _warn_secrets_keep); anything else (a note, a command, a pasted file) does.
warn_secrets() {
  local dir="$1"; shift
  local f="$dir/creds/creds.txt" line cred user pass hits
  [[ -s "$f" ]] || return 0
  while IFS= read -r line; do
    cred="$(awk '{print $3}' <<<"$line")"
    [[ "$cred" == *:* ]] || continue
    user="${cred%%:*}"
    pass="${cred#*:}"
    [[ ${#pass} -ge 4 ]] || continue
    # shellcheck disable=SC2015  # "A && B || true" is intended: a failed lookup must never abort the report
    hits="$(cd "$dir" && grep -rInHF -- "$pass" "$@" 2>/dev/null | _warn_secrets_keep "$cred" | cut -d: -f1 | sort -u | paste -sd, || true)"
    if [[ -n "$hits" ]]; then
      echo "WARNING: the password recorded for '$user' also appears in: $hits"
    fi
  done < "$f"
}

# detect_lhost: our own VPN address (tun0, else tap0), "" if there is none. (The box shell has its own
# copy of this, _lhost, because the rc file can't call back into this script on every prompt.)
detect_lhost() {
  local i a
  for i in tun0 tap0; do
    a="$(ip -4 -o addr show dev "$i" 2>/dev/null | awk '{ split($4, a, "/"); print a[1]; exit }' || true)"
    if [[ -n "$a" ]]; then printf '%s\n' "$a"; return 0; fi
  done
  return 0
}

# proof_status <box_dir> <local|proof>: how the proof checklist in notes/notes.md reads, for the report
proof_status() {
  local line v
  line="$(grep -m1 -E "^- \[[xX]\] $2\.txt:" "$1/notes/notes.md" 2>/dev/null || true)"
  [[ -n "$line" ]] || { echo "not recorded yet"; return 0; }
  v="${line#*:}"
  v="${v#"${v%%[![:space:]]*}"}"                             # ltrim
  if [[ -n "$v" ]]; then echo "captured (\`$v\`)"; else echo "captured"; fi
}

# ports_table <box_dir>: markdown table of the open ports nmap found, taken from the newest scans
# (nmap/services.gnmap, or nmap/allports.gnmap when there is no service scan yet, plus nmap/udp.gnmap).
# Prints nothing when there is nothing to show.
ports_table() {
  local dir="$1" files=() g rows
  if [[ -f "$dir/nmap/services.gnmap" ]]; then files+=("$dir/nmap/services.gnmap")
  elif [[ -f "$dir/nmap/allports.gnmap" ]]; then files+=("$dir/nmap/allports.gnmap"); fi
  if [[ -f "$dir/nmap/udp.gnmap" ]]; then files+=("$dir/nmap/udp.gnmap"); fi
  [[ ${#files[@]} -gt 0 ]] || return 0
  # gnmap line:  Host: IP ()<TAB>Ports: 22/open/tcp//ssh//OpenSSH 8.2/, 80/open/tcp//http///<TAB>...
  # per port:    port/state/proto/owner/service/rpc-info/version/   (only "open" ports are listed)
  rows="$(for g in "${files[@]}"; do
    awk '
      /^Host:/ && /Ports: / {
        p = $0; sub(/^.*Ports: /, "", p); sub(/\t.*$/, "", p)
        n = split(p, a, /, */)
        for (i = 1; i <= n; i++) {
          m = split(a[i], f, "/")
          if (f[2] != "open") continue
          ver = ""
          for (j = 7; j < m; j++) ver = ver (j > 7 ? "/" : "") f[j]
          svc = f[5]
          gsub(/\|/, "\\|", ver); gsub(/\|/, "\\|", svc)
          printf "%s\t%s\t%s\t%s\n", f[1], f[3], svc, ver
        }
      }' "$g" 2>/dev/null || true
  done | sort -s -t $'\t' -k2,2 -k1,1n | awk -F'\t' '!seen[$1 FS $2]++')"
  [[ -n "$rows" ]] || return 0
  echo "| Port | Proto | Service | Version |"
  echo "|------|-------|---------|---------|"
  awk -F'\t' '{ printf "| %s | %s | %s | %s |\n", $1, $2, ($3 == "" ? "-" : $3), ($4 == "" ? "-" : $4) }' <<<"$rows"
}

# pivot_chain <box_dir>: markdown bullet list of every `pivot` note in notes/timeline.md, in the
# order they were made - a quick top-of-report view of how an AD set's hosts chain together, since
# the full timeline (further down the report) can bury them among everything else. Prints nothing
# when there are none.
pivot_chain() {
  local tl="$1/notes/timeline.md" out
  [[ -s "$tl" ]] || return 0
  out="$(grep -E '^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}  pivot -> ' "$tl" 2>/dev/null || true)"
  [[ -n "$out" ]] || return 0
  printf '%s\n' "- ${out//$'\n'/$'\n'- }"
}

# findings_section <box_dir>: every addvuln entry in vulns/*.md, grouped by phase (initial access,
# privilege escalation, post-exploitation, then anything else) in that fixed order, each rendered as
# its own heading with Severity / Vulnerability Explanation / Vulnerability Fix - the same four
# fields the official OSCP report template asks for per finding. Entries within a phase keep
# creation order (the NN- filename prefix addvuln gives them). Prints nothing if there are none.
#
# Each finding after the first is preceded by a "---" rule. In a standalone box's own report this
# heading is a real "###" and already gets its own spacing; but under `mkbox -a`, a box this deep
# gets demoted past the template's heading-depth cap (see demote_headings) and rendered as a bold
# paragraph instead of a styled heading, which otherwise leaves two or more findings in the same
# phase running into each other with no visual break.
findings_section() {
  local dir="$1" phase label f title sev body first=1
  for phase in initial privesc post other; do
    case "$phase" in
      initial) label="Initial Access" ;;
      privesc) label="Privilege Escalation" ;;
      post)    label="Post Exploitation" ;;
      *)       label="Other Findings" ;;
    esac
    local -a files=()
    while IFS= read -r f; do
      [[ -n "$f" ]] || continue
      local p; p="$(sed -n '1s/^Phase: //p' "$f")"
      if [[ "$phase" == other ]]; then
        case "$p" in initial|privesc|post) continue ;; esac
      else
        [[ "$p" == "$phase" ]] || continue
      fi
      files+=("$f")
    done < <(find "$dir/vulns" -maxdepth 1 -name '*.md' 2>/dev/null | sort)
    [[ ${#files[@]} -gt 0 ]] || continue
    for f in "${files[@]}"; do
      title="$(sed -n '2s/^Title: //p' "$f")"
      sev="$(sed -n '3s/^Severity: //p' "$f")"
      sev="$(tr '[:lower:]' '[:upper:]' <<<"${sev:0:1}")${sev:1}"
      body="$(tail -n +5 "$f")"
      [[ "$first" -eq 1 ]] || printf -- '---\n\n'
      first=0
      printf '### %s - %s\n\n**Severity:** %s\n\n%s\n\n' "$label" "${title:-untitled}" "${sev:-Unknown}" "$body"
    done
  done
}

# demote_headings <add_n> <drop_first_h1 0|1> <max_level>: reads markdown on stdin and adds <add_n>
# '#'s to every heading. A heading whose new level would exceed <max_level> is rewritten as a bold
# paragraph instead (hashes dropped, text wrapped in **...**): most ODT templates, including
# OffSec's own, only define Heading styles a few levels deep (OffSec's goes to Heading 3, matching
# its own x.y.z numbering), and a heading pandoc can't map to a defined style renders as a plain
# paragraph with the literal "####" left in the text - visibly broken. Lines inside ``` fences are
# left alone no matter what they start with, so a `# ` comment nmap puts at the top of its own
# output (nmap -oA always starts a .nmap file with one) is never mistaken for a markdown heading.
# An empty "-" placeholder bullet (notes.md's Foothold/Privilege Escalation/etc. sections start out
# as exactly that) is rewritten too: left alone, pandoc's markdown reader doesn't treat the heading
# right after it as interrupting the list, so it comes out as literal, unparsed "### " text folded
# into that list instead of a real heading - rewriting it as a line of its own both avoids that and
# usefully flags, in the assembled draft, a section you never filled in. If <drop_first_h1> is 1, a
# lone top "# ..." line (one box's own report title) is dropped entirely, since the caller gives
# that box its own heading already.
demote_headings() {
  awk -v n="$1" -v drop="$2" -v maxlvl="$3" '
    BEGIN { pre = ""; for (i = 0; i < n; i++) pre = pre "#"; infence = 0 }
    NR == 1 && drop == 1 && $0 ~ /^# / { next }
    /^```/ { infence = !infence; print; next }
    infence { print; next }
    /^-[ \t]*$/ { print "_(nothing recorded)_"; next }
    /^#+ / {
      match($0, /^#+/)
      lvl = RLENGTH + n
      rest = substr($0, RLENGTH + 2)
      if (lvl > maxlvl) { print "**" rest "**" }
      else { print substr($0, 1, RLENGTH) pre " " rest }
      next
    }
    { print }
  '
}

# fix_odt_heading_styles <odt_file> <template_file>: two independent, unrelated patches applied to
# an already-generated ODT, both skipped (silent no-op) if python3 is missing - either way, nothing
# about the file's content is at risk, since pandoc already produced a complete, valid ODT before
# this ever runs:
#
# 1. Pandoc's ODT writer always references heading paragraph styles under the name "Heading 1",
#    "Heading 2", etc. (encoded as "Heading_20_N"). Some ODT templates - including OffSec's own exam
#    report template - instead name theirs "Heading1", "Heading2" with no separator at all (a
#    leftover of whatever tool produced the .odt). When the names don't match, --reference-doc still
#    copies the template's style *definitions* into the output, but nothing in the document actually
#    points at them, so every heading silently renders as plain body text with no visual
#    distinction. This rewrites the generated file's content.xml to reference whichever name variant
#    the template itself actually uses, for each outline level pandoc emitted.
# 2. assemble_main's cover page and the blank page before the Table of Contents both depend on a
#    paragraph style named "MkboxPageBreak" (forced page-break-before) existing somewhere in the
#    document. mkbox's own bundled template (templates/mkbox-default.odt) already defines it, but an
#    external --odt template (OffSec's own, say) won't - so this adds a minimal definition of that
#    style directly to the output's styles.xml when it's missing, rather than leaving the cover page
#    and body to run together on one page.
fix_odt_heading_styles() {
  command -v python3 >/dev/null 2>&1 || return 0
  python3 -I - "$1" "$2" <<'PYEOF'
import sys, zipfile, os

odt_path, tpl_path = sys.argv[1], sys.argv[2]

def heading_style_names(path):
    with zipfile.ZipFile(path) as z:
        names = z.namelist()
        styles = z.read('styles.xml').decode('utf-8', 'replace') if 'styles.xml' in names else ''
        content = z.read('content.xml').decode('utf-8', 'replace') if 'content.xml' in names else ''
    found = {}
    for n in range(1, 7):
        for pat in (f'Heading_20_{n}', f'Heading{n}'):
            if f'style:name="{pat}"' in styles or f'style:name="{pat}"' in content:
                found[n] = pat
                break
    return found

tpl_names = heading_style_names(tpl_path)
needs_fix = {n: real for n, real in tpl_names.items() if real != f'Heading_20_{n}'}

with zipfile.ZipFile(odt_path) as z:
    out_styles = z.read('styles.xml').decode('utf-8', 'replace') if 'styles.xml' in z.namelist() else ''
needs_pagebreak_style = 'style:name="MkboxPageBreak"' not in out_styles

if not needs_fix and not needs_pagebreak_style:
    sys.exit(0)

PAGEBREAK_STYLE = ('<style:style style:name="MkboxPageBreak" style:family="paragraph" '
                   'style:parent-style-name="Standard">'
                   '<style:paragraph-properties fo:break-before="page"/></style:style>')

tmp = odt_path + '.tmp'
with zipfile.ZipFile(odt_path) as zin, zipfile.ZipFile(tmp, 'w') as zout:
    if 'mimetype' in zin.namelist():
        zout.writestr('mimetype', zin.read('mimetype'), compress_type=zipfile.ZIP_STORED)
    for item in zin.infolist():
        if item.filename == 'mimetype':
            continue
        data = zin.read(item.filename)
        if item.filename == 'content.xml' and needs_fix:
            text = data.decode('utf-8')
            for n, real in needs_fix.items():
                text = text.replace(f'"Heading_20_{n}"', f'"{real}"')
            data = text.encode('utf-8')
        if item.filename == 'styles.xml' and needs_pagebreak_style:
            text = data.decode('utf-8')
            marker = '</office:styles>'
            if marker in text:
                text = text.replace(marker, PAGEBREAK_STYLE + marker, 1)
            data = text.encode('utf-8')
        zout.writestr(item, data, compress_type=zipfile.ZIP_DEFLATED)
os.replace(tmp, odt_path)
PYEOF
}

# _assemble_collect_warnings <box_dir> <name> <with_creds> <array_name>: runs make_report for one
# box (same as assemble_main always did) but also captures its stdout instead of discarding it
# outright, so any "WARNING: ..." line it prints (proof not marked done, an unfilled addvuln entry,
# a leaked password) isn't silently lost just because this box is one of several being collated
# instead of reported on its own. Matching lines are appended to the named array, prefixed with the
# box name, for assemble_main to print once after the draft is written.
_assemble_collect_warnings() {
  local dir="$1" name="$2" with_creds="$3"
  local -n _arr="$4"
  local _out line
  _out="$(make_report "$dir" "$name" "$with_creds" 2>&1)"
  while IFS= read -r line; do
    [[ "$line" == WARNING:* ]] || continue
    _arr+=("$name: $line")
  done <<<"$_out"
}

# assemble_main <with_creds 0|1> <odt 0|1> <odt_template|""> <outfile.md> <box...>: regenerates each
# listed box's own report, then concatenates them into one document shaped like the official OSCP
# report template - standalone boxes under "Independent Challenges", boxes marked `setad on` (or
# created with `--ad`) under "Active Directory Set" with one combined ports table of their own,
# ahead of the official template's two sections. Each box's own report is demoted two heading
# levels (its own "## Open ports" etc. become "####") so it nests under the "### Target #N - <ip>"
# / "### <boxname> - <ip>" heading assemble_main gives it, and its own top "# <name> - report draft"
# line is dropped, since that heading now exists one level up instead.
#
# High-Level Summary / Recommendations / Methodology are left as TODOs: mkbox only knows what
# happened on each box, not what to say about it, so - same as everywhere else in this report - it
# doesn't guess. The current OSCP Exam Guide doesn't ask for Maintaining Access / House Cleaning
# sections (no persistence or cleanup expected on exam hosts), so this doesn't generate stubs for
# those either; check the guide yourself before adding anything like that.
assemble_main() {
  local with_creds="$1" odt="$2" odt_tpl="$3" author="$4"; shift 4
  local outfile="${1:-}"
  if [[ -z "$outfile" ]]; then
    echo "usage: mkbox -a <outfile.md> [--odt[=template.odt]] [--author=\"Name\"] [--creds] <box1> [box2 ...]" >&2
    return 1
  fi
  shift
  if [[ $# -eq 0 ]]; then
    echo "usage: mkbox -a <outfile.md> [--odt[=template.odt]] [--author=\"Name\"] [--creds] <box1> [box2 ...]" >&2
    return 1
  fi

  local -a standalone=() adset=()
  local b dir name ad
  for b in "$@"; do
    if [[ "$b" == "." || "$b" == */* ]]; then dir="$(realpath -m -- "$b")"; else dir="$PWD/$b"; fi
    name="$(basename -- "$dir")"
    [[ -f "$dir/box.env" ]] || { echo "mkbox: no such box: $b (no box.env in $dir)" >&2; return 1; }
    ad="$(env_get "$dir" AD_SET)"
    if [[ "$ad" == "1" ]]; then adset+=("$dir|$name"); else standalone+=("$dir|$name"); fi
  done

  mkdir -p "$(dirname -- "$outfile")" 2>/dev/null || true
  {
    # The title is a bold line, not a heading: the official template's own 3 defined heading levels
    # (matching its own 1 / 1.1 / 1.1.1 numbering) are needed below for Target -> per-box sections,
    # with none to spare for a document title too.
    echo "**OSCP Exam Report - assembled draft**"
    echo
    echo "_Assembled by mkbox $VERSION on $(date '+%F %T') from $(( ${#standalone[@]} + ${#adset[@]} )) box(es). This only pulls together what's in each box - fill in the TODOs below yourself._"
    echo
    echo "# High-Level Summary"
    echo
    echo "TODO: a short, non-technical paragraph on what you tested and what you found."
    echo
    echo "# Recommendations"
    echo
    echo "TODO: your overall remediation recommendations."
    echo
    echo "# Methodology"
    echo
    echo "TODO: Information Gathering / Service Enumeration / Penetration. Check the current OSCP"
    echo "Exam Guide before writing a Maintaining Access / House Cleaning section - it doesn't ask"
    echo "for backdoors or cleanup on exam hosts."
    echo
    echo "## Tools Used"
    echo
    echo "In addition to the standard toolset (nmap, Metasploit, etc. - list anything else you used"
    echo "here), this report, its supporting notes, timeline and screenshots were compiled with"
    echo "\`mkbox\` v$VERSION (<https://github.com/cherneydh/mkbox>), a bash-based session logger and"
    echo "report collator used throughout testing."
    echo
    local e d n ip i=1
    local -a box_warnings=()
    if [[ ${#standalone[@]} -gt 0 ]]; then
      echo "# Independent Challenges"
      echo
      for e in "${standalone[@]}"; do
        d="${e%%|*}"; n="${e#*|}"
        _assemble_collect_warnings "$d" "$n" "$with_creds" box_warnings
        ip="$(env_get "$d" IP)"
        echo "## Target #$i - ${ip:-$n}"
        echo
        demote_headings 1 1 3 < "$d/report/$n-report.md"
        echo
        i=$((i + 1))
      done
    fi
    if [[ ${#adset[@]} -gt 0 ]]; then
      echo "# Active Directory Set"
      echo
      echo "| IP Address | Ports Open |"
      echo "|---|---|"
      for e in "${adset[@]}"; do
        d="${e%%|*}"; n="${e#*|}"
        ip="$(env_get "$d" IP)"
        echo "| ${ip:-$n} | TCP: $(env_get "$d" PORTS || true) |"
      done
      echo
      for e in "${adset[@]}"; do
        d="${e%%|*}"; n="${e#*|}"
        _assemble_collect_warnings "$d" "$n" "$with_creds" box_warnings
        ip="$(env_get "$d" IP)"
        echo "## $n - ${ip:-unknown}"
        echo
        demote_headings 1 1 3 < "$d/report/$n-report.md"
        echo
      done
    fi
  } > "$outfile"
  chmod 600 "$outfile" 2>/dev/null || true
  echo "Assembled draft: $outfile"
  if [[ ${#box_warnings[@]} -gt 0 ]]; then
    echo "Carried over from each box's own report - fix these before this goes in your report:"
    printf '  %s\n' "${box_warnings[@]}"
  fi

  if [[ "$odt" -eq 1 ]]; then
    local default_tpl="$MKBOX_SCRIPT_DIR/templates/mkbox-default.odt"
    local tpl="${odt_tpl:-${MKBOX_ODT_TEMPLATE:-}}"
    local using_default=0
    if [[ -z "$tpl" ]]; then
      if [[ -f "$default_tpl" ]]; then
        tpl="$default_tpl"
        using_default=1
      else
        echo "mkbox: --odt needs a template - pass --odt=/path/to/template.odt or set \$MKBOX_ODT_TEMPLATE" >&2
        echo "       (mkbox normally falls back to its own bundled templates/mkbox-default.odt - that" >&2
        echo "       file is missing from this install, which only happens if mkbox was copied without it)" >&2
        return 1
      fi
    fi
    [[ -f "$tpl" ]] || { echo "mkbox: --odt template not found: $tpl" >&2; return 1; }
    if ! command -v pandoc >/dev/null 2>&1; then
      echo "mkbox: --odt needs pandoc (sudo apt install pandoc) - the markdown draft above is still there" >&2
      return 1
    fi
    local odtfile="${outfile%.md}.odt"
    local odtsrc; odtsrc="$(mktemp "${TMPDIR:-/tmp}/mkbox-odtsrc.XXXXXX.md")"
    # Build a cover page (title/author/date), a page break, and a real ODT table-of-contents field
    # ahead of the actual report body - none of this belongs in the plain outfile.md draft itself
    # (nobody wants YAML front matter and raw ODT XML cluttering the file they're also reading as
    # Markdown), so it's assembled into a separate, temporary source file that's only ever fed to
    # pandoc. The {=opendocument} raw blocks pass straight through into the ODT's content.xml.
    # "MkboxPageBreak" is a paragraph style every mkbox-produced ODT ends up with - defined in the
    # bundled template, or added by fix_odt_heading_styles below if a custom --odt template lacks it.
    {
      echo "---"
      echo "title: \"OSCP Exam Report\""
      [[ -n "$author" ]] && printf 'author: "%s"\n' "${author//\"/\\\"}"
      echo "date: \"$(date '+%Y-%m-%d')\""
      echo "---"
      echo
      echo '```{=opendocument}'
      echo '<text:p text:style-name="MkboxPageBreak"/>'
      echo '```'
      echo
      # No manual "Table of Contents" label here - LibreOffice/Word adds that heading itself the
      # first time the index is updated (see the --odt confirmation message), so a hand-written one
      # would end up duplicated right above it.
      echo '```{=opendocument}'
      echo '<text:table-of-content text:name="mkboxTOC"><text:table-of-content-source text:outline-level="3"/><text:index-body/></text:table-of-content>'
      echo '```'
      echo
      echo '```{=opendocument}'
      echo '<text:p text:style-name="MkboxPageBreak"/>'
      echo '```'
      echo
      # everything from "# High-Level Summary" onward - i.e. the real report body, minus the
      # bold title/byline line at the top of outfile.md, which the cover page above replaces
      sed -n '/^# High-Level Summary$/,$p' "$outfile"
    } > "$odtsrc"
    # -f markdown-task_lists: the Proof checklist's "- [x] local.txt: ..." lines are GFM task-list
    # syntax. Pandoc's ODT writer renders those as Unicode checkbox glyphs (U+2610/U+2612); most
    # templates' body font (including OffSec's own) doesn't have them, so they show up as empty
    # tofu boxes instead of a check mark. Disabling the extension makes pandoc read "[x]"/"[ ]" as
    # plain text, which is what actually renders cleanly here.
    if pandoc "$odtsrc" -f markdown-task_lists --reference-doc="$tpl" -o "$odtfile"; then
      rm -f "$odtsrc"
      fix_odt_heading_styles "$odtfile" "$tpl"
      if [[ "$using_default" -eq 1 ]]; then
        echo "ODT draft:       $odtfile  (cover page, numbered headings and page numbers from mkbox's own"
        echo "                 bundled template; open it and do Tools > Update All once so the Table of"
        echo "                 Contents - whose structure is there, but not its page numbers yet - fills in)"
      else
        echo "ODT draft:       $odtfile  (styled from $tpl; open it and do Tools > Update All once so the"
        echo "                 Table of Contents fills in - still check the cover page and page numbers by hand)"
      fi
    else
      rm -f "$odtsrc"
      echo "mkbox: pandoc failed to build the ODT - the markdown draft is still at $outfile" >&2
      return 1
    fi
  fi
}

# make_report <box_dir> <name> <with_creds 0|1>
make_report() {
  local dir="$1" name="$2" with_creds="$3"
  local rdir="$dir/report" md ip f out cap lhost ports uports osinfo
  [[ -f "$dir/box.env" ]] || { echo "mkbox: $dir is not a box (no box.env)" >&2; exit 1; }

  mkdir -p "$rdir" "$dir/notes"
  md="$rdir/$name-report.md"
  # shellcheck source=/dev/null
  ip="$(. "$dir/box.env"; echo "${IP:-}")"
  ports="$(env_get "$dir" PORTS)"
  uports="$(env_get "$dir" UDP_PORTS)"
  lhost="${LHOST:-$(detect_lhost)}"                          # LHOST is set when run from inside the box shell
  osinfo="$(grep -h -m1 '^Service Info:' "$dir"/nmap/services.nmap 2>/dev/null | sed 's/^Service Info: *//' || true)"
  local gen_ts; gen_ts="$(date '+%F %T')"

  # drop a timeline note for this report run, so the Timeline section below shows a clear
  # end-of-session marker alongside whatever note was the first thing logged
  printf '%s  %s\n' "$gen_ts" "report generated" >> "$dir/notes/timeline.md"

  # make sure the cleaned log is current
  build_log "$dir" "$name"

  {
    echo "# $name - report draft"
    echo
    echo "- **Target:** ${ip:-unknown}"
    echo "- **Attacker (this machine):** ${lhost:-unknown}"
    echo "- **Generated:** $gen_ts"
    echo "- **Open TCP ports:** ${ports:-none found}"
    if [[ -n "$uports" ]]; then echo "- **Open UDP ports:** $uports"; fi
    if [[ -n "$osinfo" ]]; then echo "- **Service info (nmap):** $osinfo"; fi
    echo "- **local.txt:** $(proof_status "$dir" local)"
    echo "- **proof.txt:** $(proof_status "$dir" proof)"
    echo
    out="$(ports_table "$dir")"                               # filled in from the nmap scans, if there are any
    if [[ -n "$out" ]]; then
      echo "## Open ports (from nmap)"
      echo
      printf '%s\n' "$out"
      echo
    fi
    out="$(pivot_chain "$dir")"                               # every `pivot` note, in order - AD lateral-move chain at a glance
    if [[ -n "$out" ]]; then
      echo "## Pivot chain"
      echo
      printf '%s\n' "$out"
      echo
    fi
    out="$(findings_section "$dir")"                          # every `addvuln` entry, grouped by phase
    if [[ -n "$out" ]]; then
      echo "## Findings"
      echo
      printf '%s\n' "$out"
      echo
    fi
    echo "## Notes"
    echo
    sed '1{/^# /d}' "$dir/notes/notes.md"
    echo
    echo "## Timeline"
    echo
    out="$(chrono_log "$dir" "$name")"                        # commands + notes + screenshots, by time
    if [[ -n "$out" ]]; then
      printf '%s\n' "$out"
    elif [[ -s "$dir/notes/timeline.md" ]]; then
      printf '%s\n' '```'
      cat "$dir/notes/timeline.md"
      printf '%s\n' '```'
    else
      echo "_none_"
    fi
    echo
    echo "## Nmap results"
    echo
    out="$(files_by_mtime "$dir/nmap" -name '*.nmap')"       # oldest scan first
    if [[ -n "$out" ]]; then
      while IFS= read -r f; do
        echo "### $f"
        echo
        printf '%s\n' '```'
        cat "$dir/nmap/$f"
        printf '%s\n' '```'
        echo
      done <<<"$out"
    else
      echo "_none_"
      echo
    fi
    echo "## Screenshots"
    echo
    out="$(ordered_screenshots "$dir/screenshots")"          # in the order they were taken
    if [[ -n "$out" ]]; then
      while IFS= read -r f; do
        cap="$(awk -F'\t' -v f="$f" '$1==f {print $2 "  -  " $3; exit}' "$dir/screenshots/captions.tsv" 2>/dev/null || true)"
        echo "**$f**"
        echo
        echo "![$f](../screenshots/${f// /%20})"
        echo
        if [[ -n "$cap" ]]; then
          echo "_${cap}_"
          echo
        fi
      done <<<"$out"
    else
      echo "_none_"
      echo
    fi
    echo "## Exploits / scripts"
    echo
    exploit_list "$dir/exploits"
    echo
    echo "## Loot (filenames only)"
    echo
    md_filelist "$dir/loot"
    echo
    echo "## Credentials"
    echo
    if [[ "$with_creds" -eq 1 && -s "$dir/creds/creds.txt" ]]; then
      printf '%s\n' '```'
      cat "$dir/creds/creds.txt"
      printf '%s\n' '```'
    elif [[ -s "$dir/creds/creds.txt" ]]; then
      echo "_creds/creds.txt is not inlined here (re-run with \`mkbox -r --creds $name\` to include it). Anything you typed into notes or the terminal is still part of this report and bundle._"
    else
      echo "_none recorded_"
    fi
  } > "$md"
  chmod 600 "$md" 2>/dev/null || true

  # evidence tarball: only things that exist
  local items=() p
  for p in notes screenshots nmap exploits web "session-$name.log" "report/$name-report.md"; do
    if [[ -e "$dir/$p" ]]; then
      items+=("$p")
    fi
  done
  if [[ "$with_creds" -eq 1 && -d "$dir/creds" ]]; then
    items+=("creds")
  fi
  tar -czf "$rdir/$name-evidence.tar.gz" -C "$dir" "${items[@]}"
  chmod 600 "$rdir/$name-evidence.tar.gz" 2>/dev/null || true

  echo "Report draft: $md"
  echo "Evidence:     $rdir/$name-evidence.tar.gz"
  echo "Included in tarball: ${items[*]}"
  local unproofed=() w
  for w in local proof; do
    [[ "$(proof_status "$dir" "$w")" == "not recorded yet" ]] && unproofed+=("$w.txt")
  done
  if [[ ${#unproofed[@]} -gt 0 ]]; then
    echo "WARNING: not yet marked done: ${unproofed[*]} (run: markproof local|proof <value> once you have it)"
  fi
  local unfilled=() vf
  if [[ -d "$dir/vulns" ]]; then
    while IFS= read -r vf; do
      [[ -n "$vf" ]] || continue
      if grep -qF '(what the vulnerability is, and why this target is affected)' "$vf" \
         || grep -qF '(the concrete remediation)' "$vf"; then
        unfilled+=("$(basename -- "$vf")")
      fi
    done < <(find "$dir/vulns" -maxdepth 1 -name '*.md' 2>/dev/null | sort)
  fi
  if [[ ${#unfilled[@]} -gt 0 ]]; then
    echo "WARNING: addvuln entries still have unfilled template text: ${unfilled[*]} (edit them in vulns/ before this goes in your report)"
  fi
  if [[ "$with_creds" -eq 0 ]]; then
    echo "Left out: the creds/ and loot/ folders (use --creds to include creds/)."
    echo "That only covers those folders. Notes, exploits and the session log are bundled as typed"
    echo "(the session log includes the addcred lines you typed, passwords and all)."
    warn_secrets "$dir" "${items[@]}"
  fi
}

# Scratchpad: must be the first argument, so later arguments (note text, commands starting with "-")
# are never mistaken for mkbox options.
if [[ "${1:-}" == "-p" || "${1:-}" == "--pad" ]]; then
  shift
  pad_main "$@"
  exit $?
fi

MODE=run
NO_SHELL=0
WITH_CREDS=0
AD_FLAG=0
ODT=0
ODT_TEMPLATE=""
AUTHOR=""
POSITIONAL=()
# Flags and the box name/IP can come in any order (mkbox lame -n, mkbox -n lame, ...); only the
# first two non-flag args are ever used (box name, then IP), so this doesn't need getopt-style
# option-argument handling. -a|--assemble is the exception: ALL positionals after it are used (an
# outfile, then every box to pull into it), so its handling below the loop branches off before the
# single box name/IP logic ever runs.
while [[ $# -gt 0 ]]; do
  case "$1" in
    -n|--no-shell)  NO_SHELL=1 ;;
    -c|--clean)     MODE=clean ;;
    -r|--report)    MODE=report ;;
    -a|--assemble)  MODE=assemble ;;
    -l|--list)      MODE=list ;;
    -V|--version)   echo "mkbox $VERSION"; exit 0 ;;
    --creds)        WITH_CREDS=1 ;;
    --ad)           AD_FLAG=1 ;;
    --odt)          ODT=1 ;;
    --odt=*)        ODT=1; ODT_TEMPLATE="${1#--odt=}" ;;
    --author=*)     AUTHOR="${1#--author=}" ;;
    -h|--help)      usage 0 ;;
    --)             shift; POSITIONAL+=("$@"); break ;;
    -*)             echo "mkbox: unknown option $1" >&2; usage 1 ;;
    *)              POSITIONAL+=("$1") ;;
  esac
  shift
done
set -- "${POSITIONAL[@]}"

if [[ "$MODE" == "list" ]]; then
  list_boxes
  exit 0
fi

if [[ "$MODE" == "assemble" ]]; then
  assemble_main "$WITH_CREDS" "$ODT" "$ODT_TEMPLATE" "${AUTHOR:-${MKBOX_AUTHOR:-}}" "$@"
  exit $?
fi

TARGET="${1:-}"
IP="${2:-}"
[[ -n "$TARGET" ]] || usage 1

# Resolve the box directory relative to where mkbox was run
if [[ "$TARGET" == "." || "$TARGET" == */* ]]; then
  BOX_DIR="$(realpath -m -- "$TARGET")"
else
  BOX_DIR="$PWD/$TARGET"
fi
NAME="$(basename -- "$BOX_DIR")"

[[ "$NAME" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || { echo "mkbox: box name must start with a letter/digit and contain only letters, digits, . _ -  (got: $NAME)" >&2; exit 1; }
if [[ -n "$IP" && ! "$IP" =~ $IP_RE ]]; then
  echo "mkbox: that doesn't look like an IP/hostname: $IP" >&2
  exit 1
fi

LOG="$BOX_DIR/session-$NAME.log"

if [[ "$MODE" == "clean" ]]; then
  build_log "$BOX_DIR" "$NAME"
  [[ -f "$LOG" ]] || { echo "mkbox: no session logs found for $NAME" >&2; exit 1; }
  echo "Cleaned log: $LOG"
  exit 0
fi

if [[ "$MODE" == "report" ]]; then
  make_report "$BOX_DIR" "$NAME" "$WITH_CREDS"
  exit 0
fi

# New box or an existing one? (so a typo like `mkbox lmae` says it is creating something new)
if [[ -f "$BOX_DIR/box.env" ]]; then BOX_STATE=existing; else BOX_STATE=new; fi
if [[ ! -d "$BOX_DIR" ]]; then
  mkdir -p "$BOX_DIR"
  chmod 700 "$BOX_DIR" 2>/dev/null || true      # private by default: the logs hold everything you type
fi
for d in "${SUBDIRS[@]}"; do mkdir -p "$BOX_DIR/$d"; done

# --- keep the box out of git by default; never overwrite one the user replaced themselves ---
if [[ ! -e "$BOX_DIR/.gitignore" ]]; then
  printf '*\n' > "$BOX_DIR/.gitignore"
fi

# --- shared box state (IP, open ports, AD-set membership) lives in box.env; every tab re-reads it
# at each prompt ---
CUR_IP="$(env_get "$BOX_DIR" IP)"
CUR_AD="$(env_get "$BOX_DIR" AD_SET)"
[[ "$AD_FLAG" -eq 1 ]] && CUR_AD=1
if [[ ! -f "$BOX_DIR/box.env" || ( -n "$IP" && "$IP" != "$CUR_IP" ) || "$AD_FLAG" -eq 1 ]]; then
  write_env "$BOX_DIR" "${IP:-$CUR_IP}" "$(env_get "$BOX_DIR" PORTS)" "$(env_get "$BOX_DIR" UDP_PORTS)" "$CUR_AD"
fi

# --- notes template (only created once, never overwritten) ---
if [[ ! -f "$BOX_DIR/notes/notes.md" ]]; then
  cat > "$BOX_DIR/notes/notes.md" <<EOF
# $NAME

- **Target:** ${IP:-TBD}
- **Started:** $(date '+%F %T')

## Ports / Services
| Port | Service | Version | Notes |
|------|---------|---------|-------|
|      |         |         |       |

## Foothold
-

## Privilege Escalation
-

## Creds / Users
-

## Proof
- [ ] local.txt:
- [ ] proof.txt:

## Rabbit holes (what I tried that didn't work)
-

## Lessons learned
- **Key vulnerability / technique:**
- **What I missed or got stuck on (and why):**
- **What I'd do faster next time:**
- **To practice / memorize:**
EOF
fi
touch "$BOX_DIR/notes/timeline.md"

# --- rc file for the logged shell (regenerated each run) ---
# Written to a temp file and renamed into place, so a tab starting at this exact moment never reads
# a half-written .box.rc.
RC_TMP="$(mktemp "$BOX_DIR/.box.rc.XXXXXX")"
trap 'rm -f "$RC_TMP"' EXIT
cat > "$RC_TMP" <<'EOF'
# Sourced by the mkbox shell
[ -f "$HOME/.bashrc" ] && . "$HOME/.bashrc"
. "$BOX_DIR/box.env"

# Per-box history with timestamps, written after every command
export HISTFILE="$BOX_DIR/.bash_history_$BOX"
export HISTTIMEFORMAT="%F %T "
export HISTSIZE=100000
export HISTFILESIZE=100000
export HISTCONTROL=ignorespace   # a leading space keeps a command out of history
shopt -s histappend

# Shared state: re-read box.env before every prompt, so an IP/ports change made in another tab
# (setip, portscan, udpscan) shows up here without restarting this shell. Only re-sourced when its
# mtime has actually changed, so a manual "IP=..." edit in this tab survives until something (this
# tab's own setip/portscan, or another tab) next rewrites box.env - see the README gotcha.
_BOXENV_SEEN=""
_boxsync() {
  local m
  LHOST="$(_lhost)"; export LHOST                           # our own VPN address; follows a VPN reconnect
  [ -r "$BOX_DIR/box.env" ] || return 0
  m="$(date -r "$BOX_DIR/box.env" '+%s.%N' 2>/dev/null || true)"
  [ "$m" != "$_BOXENV_SEEN" ] || return 0
  . "$BOX_DIR/box.env"
  _BOXENV_SEEN="$m"
  return 0
}
_saveenv() {   # write IP / PORTS / UDP_PORTS / AD_SET to box.env atomically (temp file + rename)
  local t
  t="$(mktemp "$BOX_DIR/.box.env.XXXXXX")" || return 1
  printf 'export IP=%q\nexport PORTS=%q\nexport UDP_PORTS=%q\nexport AD_SET=%q\n' "${IP:-}" "${PORTS:-}" "${UDP_PORTS:-}" "${AD_SET:-0}" > "$t"
  chmod 644 "$t"
  mv -f "$t" "$BOX_DIR/box.env"
  _BOXENV_SEEN="$(date -r "$BOX_DIR/box.env" '+%s.%N' 2>/dev/null || true)"   # we already have these values; don't re-source our own write
}
# Appending ourselves is safe whether PROMPT_COMMAND is unset, a plain string, or (bash 5.1+) an
# array: `${PROMPT_COMMAND:+...}` only ever inspects/expands element 0 of an array, so a multi-element
# PROMPT_COMMAND array from .bashrc would otherwise silently lose everything past element 0. Converting
# to the array form here runs every existing entry (as bash itself does for a string) plus ours.
# Before bash 5.1 PROMPT_COMMAND can't be an array at all (bash would only ever run element 0), so
# there we append to the plain string instead.
if (( BASH_VERSINFO[0] > 5 || (BASH_VERSINFO[0] == 5 && BASH_VERSINFO[1] >= 1) )); then
  if ! declare -p PROMPT_COMMAND 2>/dev/null | grep -q '^declare -a'; then
    PROMPT_COMMAND=("${PROMPT_COMMAND:-}")
  fi
  PROMPT_COMMAND+=('history -a; _boxsync')
else
  # shellcheck disable=SC2178,SC2128  # intentional: before bash 5.1 it is only ever a plain string
  PROMPT_COMMAND="history -a; _boxsync${PROMPT_COMMAND:+; $PROMPT_COMMAND}"
fi

PS1="\[\e[1;31m\][box:$BOX]\[\e[0m\] ${PS1:-\u@\h:\w\$ }"

# ---------------------------------------------------------------- helpers
_sudo() { if [ "$(id -u)" -eq 0 ]; then "$@"; else sudo "$@"; fi; }
# _unroot <file>...: sudo nmap -oA writes its output files as root; hand them back to the user
# who's actually running the box shell (so they aren't stuck needing sudo just to read a scan).
#   - regular user (the normal Kali setup): chown them back with sudo. The nmap run just before has
#     the credentials cached, and -n means this can never hang on a password prompt.
#   - root shell started with `sudo -i` / `sudo su`: give them to $SUDO_USER.
# $SUDO_USER can't be used to detect the first case: sudo sets it only for the command it launches,
# never in your own shell.
_unroot() {
  if [ "$(id -u)" -eq 0 ]; then
    [ -n "${SUDO_USER:-}" ] || return 0
    chown "$SUDO_USER" "$@" 2>/dev/null || true
  else
    sudo -n chown "$(id -u):$(id -g)" "$@" 2>/dev/null || true
  fi
}

# --- notes & navigation
note()     { printf '%s  %s\n' "$(date '+%F %T')" "$*" >> "$BOX_DIR/notes/timeline.md"; }   # note "got creds for bob"
pivot() {                                                                                    # pivot <to-host> <via> [note]  -  e.g. pivot DC01 "psexec with bob:ntlm-hash"
  [ $# -ge 2 ] || { echo 'usage: pivot <to-host> <via> [note]'; return 1; }
  local to="$1" via="$2"; shift 2
  note "pivot -> $to via $via${*:+ ($*)}"
  echo "pivot recorded: -> $to via $via"
}
boxcd()    { cd "$BOX_DIR/${1:-}" || return; }                                               # boxcd nmap
pad() {                                                                                      # scratchpad: pad [-g] [edit|add|cmd|show|grep|path]
  local scope="$BOX_DIR"
  if [ "${1:-}" = "-g" ]; then scope=-g; shift; fi
  if [ "${1:-}" = "cmd" ] && [ $# -eq 1 ]; then          # bare `pad cmd` saves the previous command (this one is already in history)
    set -- cmd "$(fc -ln -2 -2 2>/dev/null | sed 's/^[[:space:]]*//')"
  fi
  "$MKBOX_BIN" -p "$scope" "$@"
}
boxinfo() {                                                                                  # status overview
  echo "Box:    $BOX"
  echo "Target: ${IP:-<unset>}"
  echo "Local:  ${LHOST:-<no tun0/tap0>}"
  echo "Dir:    $BOX_DIR"
  [ -n "${PORTS:-}" ] && echo "Ports:  $PORTS"
  [ -n "${UDP_PORTS:-}" ] && echo "UDP:    $UDP_PORTS"
  [ "${AD_SET:-0}" = 1 ] && echo "AD set: yes"
  printf 'Files:  '
  for d in nmap web loot exploits screenshots; do
    printf '%s=%s ' "$d" "$(find "$BOX_DIR/$d" -type f 2>/dev/null | wc -l)"
  done
  echo
  echo "Proof:"
  grep -E '^- \[.\] (local|proof)\.txt' "$BOX_DIR/notes/notes.md" | sed 's/^/  /'
  echo "Recent timeline:"
  tail -n 5 "$BOX_DIR/notes/timeline.md" | sed 's/^/  /'
}
setad() {                                                                                    # setad on|off  -  mark/unmark this box as part of the Active Directory set
  case "${1:-}" in
    on|1|yes) AD_SET=1 ;;
    off|0|no) AD_SET=0 ;;
    *) echo "usage: setad on|off"; return 1 ;;
  esac
  export AD_SET
  _saveenv
  note "AD set membership: $([ "$AD_SET" = 1 ] && echo on || echo off)"
  echo "AD_SET=$AD_SET"
}
setip() {                                                                                    # setip 10.10.10.4 (after a machine revert)
  [ -n "${1:-}" ] || { echo "usage: setip <ip>"; return 1; }
  if ! [[ "$1" =~ $MKBOX_IP_RE ]]; then                    # same check mkbox itself applies
    echo "setip: that doesn't look like an IP/hostname: $1"
    return 1
  fi
  _boxsync
  IP="$1"; export IP
  _saveenv                                                 # other tabs pick this up at their next prompt
  sed -i "s|^- \\*\\*Target:\\*\\* .*|- **Target:** $IP|" "$BOX_DIR/notes/notes.md"   # keep the notes header in sync
  note "target IP set to $IP"
  echo "IP=$IP"
}

# --- recon wrappers (plain nmap with fixed flags; output goes to nmap/)
# _archive_scan <name>: before a scan overwrites nmap/<name>.*, keep the previous results as
# <name>-<time of that scan>.<ext>, so a re-run (e.g. after a machine revert) loses nothing
_archive_scan() {
  local ext f stamp
  for ext in nmap gnmap xml; do
    f="$BOX_DIR/nmap/$1.$ext"
    if [ -f "$f" ]; then
      stamp="$(date -r "$f" '+%Y%m%d-%H%M%S')"
      mv -f "$f" "$BOX_DIR/nmap/$1-$stamp.$ext"
    fi
  done
}
portscan() {                                                                                 # all TCP ports -> nmap/allports.*, sets $PORTS
  [ -n "${IP:-}" ] || { echo "IP not set (use: setip <ip>)"; return 1; }
  _archive_scan allports
  _sudo nmap -p- --min-rate 2000 -T4 -oA "$BOX_DIR/nmap/allports" "$IP" || return
  _unroot "$BOX_DIR/nmap/allports".{nmap,gnmap,xml}
  local found
  found="$(grep -oE '[0-9]+/open/tcp' "$BOX_DIR/nmap/allports.gnmap" | cut -d/ -f1 | sort -un | paste -sd,)"
  _boxsync; PORTS="$found"; export PORTS; _saveenv         # shared with the other tabs
  note "portscan: open ports ${PORTS:-none}"
  echo "Open ports: ${PORTS:-none}"
}
udpscan() {                                                                                  # udpscan [N] -> top-N UDP ports + version detection
  local n="${1:-20}" found maybe
  case "$n" in ''|*[!0-9]*) echo "usage: udpscan [number-of-top-ports]"; return 1 ;; esac
  [ -n "${IP:-}" ] || { echo "IP not set (use: setip <ip>)"; return 1; }
  echo "UDP scans are slow (minutes). Consider running this in a second tab."
  _archive_scan udp
  _sudo nmap -sU -sV --top-ports "$n" --open -oA "$BOX_DIR/nmap/udp" "$IP" || return
  _unroot "$BOX_DIR/nmap/udp".{nmap,gnmap,xml}
  found="$(grep -oE '[0-9]+/open/udp' "$BOX_DIR/nmap/udp.gnmap" | cut -d/ -f1 | sort -un | paste -sd,)"
  maybe="$(grep -oE '[0-9]+/open\|filtered/udp' "$BOX_DIR/nmap/udp.gnmap" | cut -d/ -f1 | sort -un | paste -sd,)"
  _boxsync; UDP_PORTS="$found"; export UDP_PORTS; _saveenv
  note "udpscan top $n: open UDP ports ${UDP_PORTS:-none}${maybe:+ (open|filtered: $maybe)}"
  echo "Open UDP ports: ${UDP_PORTS:-none}"
  [ -n "$maybe" ] && echo "open|filtered (not stored in \$UDP_PORTS; check nmap/udp.nmap): $maybe"
  return 0
}
svcscan() {                                                                                  # svcscan [ports] -> default scripts + versions
  local p="${1:-${PORTS:-}}"
  [ -n "${IP:-}" ] || { echo "IP not set (use: setip <ip>)"; return 1; }
  [ -n "$p" ] || { echo "no ports: run portscan first, or: svcscan 22,80"; return 1; }
  case "$p" in *[!0-9,-]*) echo "svcscan: ports must be numbers or ranges separated by commas (got: $p)"; return 1 ;; esac
  _archive_scan services
  _sudo nmap -sC -sV -p "$p" -oA "$BOX_DIR/nmap/services" "$IP" && { _unroot "$BOX_DIR/nmap/services".{nmap,gnmap,xml}; note "svcscan on ports $p"; }
}

# --- screenshots (from the clipboard)
shot() {                                                                                     # shot "what this shows" -> saves the clipboard image
  local msg="${*:-screenshot}" ts slug f n=1 tmp
  msg="${msg//$'\t'/ }"
  ts="$(date '+%Y%m%d-%H%M%S')"
  slug="$(printf '%s' "$msg" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-//; s/-$//' | cut -c1-40)"
  f="$ts-${slug:-screenshot}.png"
  while [ -e "$BOX_DIR/screenshots/$f" ]; do n=$((n+1)); f="$ts-${slug:-screenshot}-$n.png"; done
  tmp="$(mktemp)"
  if [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-paste >/dev/null 2>&1; then
    wl-paste --type image/png > "$tmp" 2>/dev/null
  elif command -v xclip >/dev/null 2>&1; then
    xclip -selection clipboard -t image/png -o > "$tmp" 2>/dev/null
  else
    rm -f "$tmp"; echo "shot: need xclip (X11) or wl-clipboard (Wayland):  sudo apt install xclip"; return 1
  fi
  if [ "$(head -c 8 "$tmp" 2>/dev/null | od -An -tx1 | tr -d ' \n')" != "89504e470d0a1a0a" ]; then
    rm -f "$tmp"; echo "shot: no PNG image on the clipboard (copy the screenshot first)"; return 1
  fi
  chmod 644 "$tmp"
  mv "$tmp" "$BOX_DIR/screenshots/$f"
  printf '%s\t%s\t%s\n' "$f" "$(date '+%F %T')" "$msg" >> "$BOX_DIR/screenshots/captions.tsv"
  note "screenshot $f - $msg"
  echo "saved screenshots/$f"
}

# --- file transfer
_lhost() {                                                                     # our VPN address (tun0, else tap0), for $LHOST and the client hints; "" if there is none
  local i a
  for i in tun0 tap0; do
    a="$(ip -4 -o addr show dev "$i" 2>/dev/null | awk '{ split($4, a, "/"); print a[1]; exit }')"
    if [ -n "$a" ]; then printf '%s\n' "$a"; return 0; fi
  done
  return 0
}
# _serve_hints <mode> <host> <port> <share> <user>: copy-paste client commands for the target
_serve_hints() {
  local mode="$1" h="$2" port="$3" share="$4" user="$5" p=""
  echo "On the target (replace FILE):"
  case "$mode" in
    http)
      [ "$port" != 80 ] && p=":$port"
      echo "  Linux:   wget http://$h$p/FILE      or  curl -O http://$h$p/FILE"
      echo "  Windows: certutil -urlcache -split -f http://$h$p/FILE FILE"
      echo "           powershell iwr http://$h$p/FILE -OutFile FILE"
      ;;
    smb)
      if [ -n "$user" ]; then
        printf '  Windows: net use \\\\%s\\%s /user:%s <password>\n' "$h" "$share" "$user"
      fi
      printf '  Windows: copy \\\\%s\\%s\\FILE .          (upload: copy FILE \\\\%s\\%s\\)\n' "$h" "$share" "$h" "$share"
      [ "$port" != 445 ] && echo "  (non-standard port $port: Windows' built-in SMB client can only use 445)"
      ;;
    webdav)
      [ "$port" != 80 ] && p=":$port"
      if [ "$port" = 80 ]; then
        printf '  Windows: copy \\\\%s\\DavWWWRoot\\FILE .\n' "$h"
      else
        printf '  Windows: copy \\\\%s@%s\\DavWWWRoot\\FILE .\n' "$h" "$port"
      fi
      echo "  Linux:   curl -O http://$h$p/FILE      upload: curl -T FILE http://$h$p/"
      ;;
  esac
}
serve() {   # serve [--smb|--webdav|--http] [--bind <ip>] [--share <name>] [--auth user:pass] [port]  (serves transfer/)
  local mode="http" bind="" port="" share="share" auth="" tool="" t dir="$BOX_DIR/transfer"
  local usage="usage: serve [--smb|--webdav|--http] [--bind <ip>] [--share <name>] [--auth user:pass] [port]"
  while [ $# -gt 0 ]; do
    case "$1" in
      --smb)    mode=smb; shift ;;
      --webdav) mode=webdav; shift ;;
      --http)   mode=http; shift ;;
      --bind)   bind="${2:-}"; shift 2 ;;
      --bind=*) bind="${1#--bind=}"; shift ;;
      --share)  share="${2:-}"; shift 2 ;;
      --share=*) share="${1#--share=}"; shift ;;
      --auth)   auth="${2:-}"; shift 2 ;;
      --auth=*) auth="${1#--auth=}"; shift ;;
      *) port="$1"; shift ;;
    esac
  done
  # Default ports: http and webdav 80, smb 445.
  if [ -z "$port" ]; then
    case "$mode" in smb) port=445 ;; *) port=80 ;; esac
  fi
  case "$port" in ''|*[!0-9]*) echo "$usage"; return 1 ;; esac
  case "$share" in ''|*[!A-Za-z0-9._-]*) echo "serve: --share must be letters, digits, . _ -"; return 1 ;; esac
  if [ -n "$auth" ]; then
    case "$auth" in *:*) ;; *) echo "serve: --auth needs user:pass"; return 1 ;; esac
    [ "$mode" = smb ] || { echo "serve: --auth is only supported with --smb"; return 1; }
  fi
  # Default (no --bind): every interface, so transfer/ is reachable from anywhere on your network, not
  # just the target. Pass --bind <your-vpn-ip> (e.g. tun0) to restrict it, or --bind 127.0.0.1 if
  # you're only serving over a tunnel/port-forward.
  local cmd=()
  if [ "$port" -lt 1024 ] && [ "$(id -u)" -ne 0 ]; then cmd=(sudo); fi   # privileged port
  case "$mode" in
    http)
      cmd+=(python3 -m http.server)
      [ -n "$bind" ] && cmd+=(--bind "$bind")
      cmd+=("$port")
      ;;
    smb)
      # impacket's smbserver (Kali: package python3-impacket, command impacket-smbserver)
      for t in impacket-smbserver impacket-smbserver.py smbserver.py; do
        if command -v "$t" >/dev/null 2>&1; then tool="$(command -v "$t")"; break; fi
      done
      [ -n "$tool" ] || { echo "serve: --smb needs impacket's smbserver:  sudo apt install python3-impacket"; return 1; }
      cmd+=("$tool" -smb2support -port "$port")
      [ -n "$bind" ] && cmd+=(-ip "$bind")
      [ -n "$auth" ] && cmd+=(-username "${auth%%:*}" -password "${auth#*:}")
      cmd+=("$share" "$dir")
      ;;
    webdav)
      # WsgiDAV (Kali: package wsgidav)
      tool="$(command -v wsgidav 2>/dev/null || true)"
      [ -n "$tool" ] || { echo "serve: --webdav needs WsgiDAV:  sudo apt install wsgidav   (or: pip install wsgidav cheroot)"; return 1; }
      cmd+=("$tool" --host "${bind:-0.0.0.0}" --port "$port" --root "$dir" --auth anonymous)
      ;;
  esac

  local h="${bind:-$(_lhost)}" start rc
  h="${h:-<your-ip>}"
  [ "$h" = 0.0.0.0 ] && h="<your-ip>"
  echo "Serving $dir over $mode on port $port${bind:+ (bind $bind)}  -  Ctrl-C to stop"
  _serve_hints "$mode" "$h" "$port" "$share" "${auth%%:*}"
  # timeline note: what, where, who - never the password
  local detail="port $port"
  [ -n "$bind" ] && detail="$detail, bind $bind"
  [ "$mode" = smb ] && detail="$detail, share $share"
  [ -n "$auth" ] && detail="$detail, user ${auth%%:*}"
  note "serve: $mode started ($detail)"
  start=$(date +%s)
  # A handled SIGINT keeps this function running after Ctrl-C, so the "ended" note below is written.
  trap ':' INT
  ( cd "$dir" && "${cmd[@]}" )
  rc=$?
  trap - INT
  note "serve: $mode ended (exit $rc, $(( $(date +%s) - start ))s)"
  return $rc
}

# --- remote/transfer session logging -------------------------------------------------------
# Connecting out (ssh, ftp, rdp, ...) is one of the most report-relevant things you do, so the
# commands in $MKBOX_NET_CMDS get a timestamped start/end timeline note - same idea as portscan.
#
# This is pure passthrough, NOT a pty wrapper: `command "$name" "$@"` runs the real binary directly
# in the foreground. Your terminal's stdin/stdout/stderr, job control, Ctrl-C, window resizes, and
# the real exit code all reach it exactly as if you'd typed it without mkbox - nothing is piped,
# backgrounded, or re-parented, so full-screen programs (vim or a shell over ssh), password
# prompts, and `scp`/`sftp` progress bars behave normally. A wrapper is only installed for a name
# if that binary is actually on PATH, so nothing is ever shadowed by a "command not found".
#
# Known, documented gaps (same spirit as addcred/warn_secrets - see README):
#   - sudo bypasses the wrapper (sudo resolves the real binary via PATH, not shell functions), so
#     `sudo nc ...` is logged by history like any other command but not start/end-timestamped.
#   - To run the real binary once without the wrapper: `command ssh ...` or `\ssh ...`.
#   - To add more tools, add their names to MKBOX_NET_CMDS (or set it in your own ~/.bashrc, which
#     loads before this file, and it will be respected). Set it in the environment you run mkbox
#     from if you also want the report's command timeline to mask passwords for those tools.
#   - In a pipeline (`ssh host cmd | tee out`), $? after the pipeline is bash's normal pipeline
#     status, same as without the wrapper.
# (MKBOX_NET_CMDS itself is set and exported by mkbox before this shell starts.)

# _netmask <tool> <args...>: the command line with passwords masked, for the timeline note only (the
# raw session log always has the real command - see Caveats). It uses the same mask_cmd() as the
# report (appended below as $MKBOX_MASK_AWK), so the two can't disagree. A password typed at an
# interactive prompt was never on the command line, so there is nothing to mask.
_netmask() {
  local masked
  masked="$(printf '%s\n' "$*" | awk -v tools="$MKBOX_NET_CMDS" "$MKBOX_MASK_AWK"$'\n''{ print mask_cmd($0) }')"
  printf '%s' "${masked#"$1" }"
}
_netlog() {
  local name="$1"; shift
  local start end dur rc shown
  shown="$(_netmask "$name" "$@")"
  note "$name: started${shown:+ ($shown)}"
  # One-line markers go to the terminal (so `script` records them) when stderr is a terminal. The report
  # uses them to cut this connection's transcript out of the session log (see chrono_log).
  if [ -t 2 ]; then printf '[mkbox >>> %s started %s]\n' "$name" "$(date '+%F %T')" >&2; fi
  start=$(date +%s)
  command "$name" "$@"
  rc=$?
  end=$(date +%s); dur=$((end - start))
  if [ -t 2 ]; then printf '\n[mkbox <<< %s ended %s exit %s]\n' "$name" "$(date '+%F %T')" "$rc" >&2; fi
  note "$name: ended (exit $rc, ${dur}s)"
  return $rc
}
for _mkbox_netcmd in $MKBOX_NET_CMDS; do
  if command -v "$_mkbox_netcmd" >/dev/null 2>&1; then
    eval "$_mkbox_netcmd() { _netlog '$_mkbox_netcmd' \"\$@\"; }"
  fi
done
unset _mkbox_netcmd

# --- creds & proof
addcred() {                                                                                  # addcred user:pass [where found]
  [ $# -ge 1 ] || { echo 'usage: addcred user:pass [where found / service]'; return 1; }
  local f="$BOX_DIR/creds/creds.txt" c="$1"; shift
  [ -f "$f" ] || ( umask 077; : > "$f" )
  printf '%s  %s  (%s)\n' "$(date '+%F %T')" "$c" "${*:-no source noted}" >> "$f"
  note "cred recorded for ${c%%:*} (${*:-no source noted})"      # timeline gets the username only, never the password
}
addexploit() {                                                                               # addexploit <file in exploits/> <source url> [what you changed]
  [ $# -ge 2 ] || { echo 'usage: addexploit <file-in-exploits/> <source-url> [what you changed]'; return 1; }
  local file="$1" src="$2" f="$BOX_DIR/exploits/SOURCES.md"; shift 2
  [ -f "$f" ] || printf '# Exploit sources\n\nOne entry per file in this folder: where it came from, and what (if anything) was changed.\n\n' > "$f"
  printf -- '- **%s** - `%s`\n  - Source: %s\n  - Modified: %s\n' "$(date '+%F %T')" "$file" "$src" "${*:-no, used as-is}" >> "$f"
  note "exploit recorded: $file (source: $src)"
}
addvuln() {                                                                                  # addvuln initial|privesc|post "<title>" critical|high|medium|low
  local phase="${1:-}" title="${2:-}" sev="${3:-}"
  local usg='usage: addvuln initial|privesc|post "<title>" critical|high|medium|low   (opens $EDITOR for the Explanation/Fix text)'
  case "$phase" in initial|privesc|post) ;; *) echo "$usg"; return 1 ;; esac
  [ -n "$title" ] || { echo "$usg"; return 1; }
  sev="$(tr '[:upper:]' '[:lower:]' <<<"$sev")"
  case "$sev" in critical|high|medium|low) ;; *) echo "$usg"; return 1 ;; esac
  mkdir -p "$BOX_DIR/vulns"
  local n slug f ed
  n=$(( $(find "$BOX_DIR/vulns" -maxdepth 1 -name '*.md' 2>/dev/null | wc -l) + 1 ))
  slug="$(printf '%s' "$title" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' | cut -c1-40)"
  f="$BOX_DIR/vulns/$(printf '%02d' "$n")-$phase-${slug:-finding}.md"
  if [ ! -e "$f" ]; then
    printf 'Phase: %s\nTitle: %s\nSeverity: %s\n\n**Vulnerability Explanation:** (what the vulnerability is, and why this target is affected)\n\n**Vulnerability Fix:** (the concrete remediation)\n' \
      "$phase" "$title" "$sev" > "$f"
  fi
  ed="${VISUAL:-${EDITOR:-}}"
  if [ -z "$ed" ]; then
    for ed in nano vim vi; do command -v "$ed" >/dev/null 2>&1 && break; ed=""; done
  fi
  if [ -z "$ed" ]; then
    echo "mkbox: no editor found - set \$EDITOR, or fill in $f yourself"
  else
    # shellcheck disable=SC2086
    $ed "$f"
  fi
  note "vuln recorded: [$phase] $title ($sev)"
  echo "finding saved: $f"
}
markproof() {                                                                                # markproof local|proof [value]   (-u to untick)
  local undo=0 which val mark=x f="$BOX_DIR/notes/notes.md" t
  if [ "${1:-}" = "-u" ]; then undo=1; mark=" "; shift; fi
  case "${1:-}" in
    local|user) which=local ;;
    proof|root) which=proof ;;
    *) echo "usage: markproof local|proof [value]    (markproof -u local|proof to untick)"; return 1 ;;
  esac
  shift
  val="$*"; val="${val//$'\n'/ }"
  [ -f "$f" ] || { echo "markproof: no notes/notes.md"; return 1; }
  grep -qE "^- \[.\] $which\.txt:" "$f" || { echo "markproof: no '- [ ] $which.txt:' line in notes/notes.md (template changed?)"; return 1; }
  t="$(mktemp "$BOX_DIR/notes/.notes.XXXXXX")" || return 1
  # with a value, it replaces whatever followed the colon; without one, what was there is kept
  MK_VAL="$val" awk -v w="$which" -v m="$mark" '
    $0 ~ ("^- \\[.\\] " w "\\.txt:") {
      v = ENVIRON["MK_VAL"]
      rest = (v != "") ? " " v : substr($0, index($0, ":") + 1)
      print "- [" m "] " w ".txt:" rest
      next
    }
    { print }' "$f" > "$t" || { rm -f "$t"; return 1; }
  chmod --reference="$f" "$t" 2>/dev/null || chmod 644 "$t"
  mv -f "$t" "$f"
  if [ "$undo" -eq 1 ]; then
    note "proof: $which.txt unmarked"
    echo "$which.txt unticked"
  else
    note "proof: $which.txt marked done${val:+ ($val)}"
    echo "$which.txt ticked${val:+ ($val)}"
  fi
}
proofshot() {                                                                                # proofshot local|proof [flag value]  -  shot + markproof in one step
  local which="${1:-}"
  case "$which" in
    local|user) which=local ;;
    proof|root) which=proof ;;
    *) echo "usage: proofshot local|proof [flag value]   (run proofcmd first to see what must be in the shot)"; return 1 ;;
  esac
  shift
  shot "${which}.txt proof${*:+ ($*)}" || return 1
  markproof "$which" "$@"
}
proofcmd() {                                                                                 # prints proof one-liners to paste on the target
  cat <<'P'
Linux:
  cat /root/proof.txt /root/flag.txt 2>/dev/null; whoami; hostname; ip a
  cat ~/local.txt ~/flag.txt 2>/dev/null; whoami; hostname; ip a

Windows (cmd.exe - & runs the rest even if the first command fails):
  (type C:\Users\Administrator\Desktop\proof.txt || type C:\Users\Administrator\Desktop\flag.txt) & whoami & hostname & ipconfig

Windows (PowerShell - works on every version; && is PS7+ only, so this uses ; instead):
  Get-Content "C:\Users\Administrator\Desktop\proof.txt","C:\Users\Administrator\Desktop\flag.txt" -ErrorAction SilentlyContinue; whoami; hostname; ipconfig
P
}

