#!/usr/bin/env bash
# mkbox - create (or re-enter) a per-box workspace and drop into a logged shell.
#
# Usage:  mkbox [-n|--no-shell] <boxname|path> [target-ip]
#         mkbox -c|--clean  <boxname|path>          rebuild the cleaned session log
#         mkbox -r|--report [--creds] <boxname|path> build a report draft + evidence tarball
#         mkbox -l|--list                            list boxes in the current directory
#         mkbox -V|--version                         print the version
#
# The box is created in the CURRENT directory:
#   mkbox lame 10.10.10.3     -> ./lame
#   mkbox .                   -> use the current directory as the box
#   mkbox ~/labs/htb/lame     -> any path works; the last component is the box name
#
# Reports (-r) merge your shell history, timeline notes and screenshot captions into one
# chronological log (GNU date required); `addcred` commands are shown with the password masked.
#
# Logs:   session-<name>.log        cleaned (no escape codes), regenerated on exit; one
#                                   labeled section per session/tab, in start order
#         .sessions/<start>-<pid>.raw   raw `script` output, one file per mkbox invocation
#                                   (so several tabs can be open on the same box safely)

set -euo pipefail

VERSION="1.0.1"

# Written for bash 4.4+ (empty arrays under `set -u`, associative arrays); developed on 5.2.
if (( BASH_VERSINFO[0] < 4 || (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] < 4) )); then
  echo "mkbox: needs bash 4.4 or newer (this is ${BASH_VERSION%%[( ]*})" >&2
  exit 1
fi

SUBDIRS=(nmap web loot exploits creds notes screenshots transfer)
# Commands that get a start/end note in the timeline (wrapped inside the box shell) and whose
# command lines get password masking in reports. Override it in your environment or ~/.bashrc.
MKBOX_NET_CMDS="${MKBOX_NET_CMDS:-ssh sshpass ftp sftp ncftp lftp smbclient rdesktop xfreerdp remmina nc ncat netcat telnet mysql psql evil-winrm}"
export MKBOX_NET_CMDS
# Accepted target IP/hostname; also exported to the box shell for `setip`. It must not start with
# "-" so a value like "-sV" can never be mistaken for an nmap option later.
IP_RE='^[A-Za-z0-9:][A-Za-z0-9.:-]*$'

# env_get <box_dir> <VAR>: read one variable from box.env ("" if unset or the file is missing)
env_get() {
  [[ -f "$1/box.env" ]] || return 0
  # shellcheck source=/dev/null
  ( . "$1/box.env" 2>/dev/null; printf '%s' "${!2:-}" ) || true
}

# write_env <box_dir> <ip> <ports> <udp_ports>: rewrite box.env atomically (temp file + rename),
# so a tab that re-reads it at that moment never sees a half-written file
write_env() {
  local t
  t="$(mktemp "$1/.box.env.XXXXXX")"
  printf 'export IP=%q\nexport PORTS=%q\nexport UDP_PORTS=%q\n' "$2" "$3" "$4" > "$t"
  chmod 644 "$t"
  mv -f "$t" "$1/box.env"
}

usage() {
  cat >&2 <<'U'
Usage: mkbox [-n|--no-shell] <boxname|path> [target-ip]
       mkbox -c|--clean  <boxname|path>
       mkbox -r|--report [--creds] <boxname|path>
       mkbox -l|--list
       mkbox -V|--version
U
  exit "${1:-1}"
}

# Line-level terminal emulation used by clean_log. For each line it keeps a cursor and applies what
# a terminal would: \r and \b move the cursor and later characters OVERWRITE (nothing is deleted),
# ESC[K erases to end of line, ESC[nC / ESC[nD / ESC[nG move the cursor, ESC[nP deletes, ESC[n@ inserts.
# Colors, window titles, bracketed-paste toggles and other control codes are dropped. This is the
# same overwrite behaviour as `col -b`, plus the erase/cursor sequences readline uses when it
# redraws a line (tab completion, Ctrl-R, history recall). It cannot follow cursor-up redraws of
# lines that wrap across several screen rows.
read -r -d '' CLEAN_PL <<'PERL' || true
use strict; use warnings; no warnings 'utf8';
binmode(STDIN); binmode(STDOUT);
while (my $line = <STDIN>) {
    my $nl = ($line =~ s/\n\z//) ? "\n" : "";
    my $utf8 = utf8::decode($line);          # stays as raw bytes if the line isn't valid UTF-8
    my @b; my $p = 0;
    pos($line) = 0;
    while (pos($line) < length($line)) {
        if ($line =~ /\G\e\[([0-9;?]*)[ -\/]*([\@-~])/gc) {
            my ($arg, $fin) = ($1, $2);
            my $n = ($arg =~ /^(\d+)/) ? $1 : undef;
            if    ($fin eq 'K') {
                my $m = $n // 0;
                if    ($m == 0) { splice(@b, $p) if $p < @b }
                elsif ($m == 1) { for my $i (0 .. $p - 1) { $b[$i] = ' ' if $i < @b } }
                else            { @b = () }
            }
            elsif ($fin eq 'C') { $p += ($n || 1) }
            elsif ($fin eq 'D') { $p -= ($n || 1); $p = 0 if $p < 0 }
            elsif ($fin eq 'G') { $p = ($n || 1) - 1 }
            elsif ($fin eq 'P') { splice(@b, $p, $n || 1) if $p < @b }
            elsif ($fin eq '@') { push @b, ' ' while @b < $p; splice(@b, $p, 0, (' ') x ($n || 1)) }
            elsif ($fin eq 'X') { for my $i ($p .. $p + ($n || 1) - 1) { $b[$i] = ' ' if $i < @b } }
        }
        elsif ($line =~ /\G\e\][^\a\e]*(?:\a|\e\\)/gc) { }
        elsif ($line =~ /\G\e[()][0-9A-Za-z]/gc)         { }
        elsif ($line =~ /\G\e.?/gcs)                     { }
        elsif ($line =~ /\G\r/gc)                        { $p = 0 }
        elsif ($line =~ /\G\x08/gc)                      { $p-- if $p > 0 }
        elsif ($line =~ /\G[\x00-\x07\x0b\x0c\x0e-\x1a\x1c-\x1f\x7f]/gc) { }
        elsif ($line =~ /\G(.)/gcs) {
            push @b, ' ' while @b < $p;
            $b[$p++] = $1;
        }
    }
    my $out = join('', map { defined $_ ? $_ : ' ' } @b);
    $out =~ s/ +\z//;
    utf8::encode($out) if $utf8;
    print $out, $nl;
}
PERL

# Best-effort password masking for command lines, as an awk program. It is used in two places so they
# can never disagree: the report's command timeline (chrono_log) and the live start/end notes that the
# ssh/ftp/... wrappers write to timeline.md (_netmask in the box shell). Only commands whose first word
# is in $MKBOX_NET_CMDS (an optional leading `sudo` is ignored) are touched, and each tool only gets
# the rules that fit it - e.g. `ssh -p 2222` is a port, so it is left alone, while `sshpass -p` is a
# password. The raw session log always has the real command; this only affects what is *reported*.
read -r -d '' MASK_AWK <<'AWK' || true
# mask_after(s, re, sep, skip, tail): for each match of re in s, keep the text up to and including the
# first sep (searched after the first <skip> characters of the match), replace the rest with ***, and
# add <tail>. If the kept part opened a quote that the match closes (-U 'user%pass'), the closing quote
# is added back so the line stays balanced. A match without sep is left alone.
function mask_after(s, re, sep, skip, tail,    out, m, t, last, keep, tl) {
  out = ""
  while (match(s, re) && RLENGTH > 0) {
    m = substr(s, RSTART, RLENGTH)
    t = index(substr(m, skip + 1), sep)
    if (t > 0) {
      keep = substr(m, 1, skip + t)
      last = substr(m, length(m), 1)
      tl = tail
      if ((last == "'" || last == "\"") && index(keep, last) > 0) tl = tl last
      m = keep "***" tl
    }
    out = out substr(s, 1, RSTART - 1) m
    s = substr(s, RSTART + RLENGTH)
  }
  return out s
}
function mask_cmd(cmd,    rest, tool, arg) {
  rest = cmd
  sub(/^[ \t]*(sudo[ \t]+)?/, "", rest)
  tool = rest
  sub(/[ \t].*$/, "", tool)
  sub(/^.*\//, "", tool)
  if (index(" " tools " ", " " tool " ") == 0) return cmd
  arg = "('[^']*'|\"[^\"]*\"|[^ \t]+)"            # one shell word, optionally quoted

  # every wrapped tool: --password/--pass (with = or a space) and user:pass@ in a URL
  cmd = mask_after(cmd, "--pass(word)?=" arg, "=", 0, "")
  cmd = mask_after(cmd, "--pass(word)?[ \t]+" arg, " ", 0, "")
  cmd = mask_after(cmd, "://[^/@ \t:]*:[^/@ \t]*@", ":", 3, "@")

  if (tool == "sshpass" || tool == "evil-winrm" || tool == "rdesktop" || tool == "ncftp")
    cmd = mask_after(cmd, "[ \t]-p[ \t]+" arg, " ", 3, "")      # -p PASS (for ssh/nc/psql -p is a port: untouched)
  if (tool == "evil-winrm")
    cmd = mask_after(cmd, "[ \t]-H[ \t]+" arg, " ", 3, "")      # NTLM hash
  if (tool == "mysql")
    cmd = mask_after(cmd, "[ \t]-p" arg, "p", 2, "")            # -pPASS (attached; a bare -p just prompts)
  if (tool == "smbclient")
    cmd = mask_after(cmd, "(-U[ \t]*|--user=)" arg, "%", 0, "") # -U user%pass
  if (tool == "xfreerdp" || tool == "remmina")
    cmd = mask_after(cmd, "/g?p(th)?:" arg, ":", 0, "")         # /p:PASS  /pth:HASH  /gp:GATEWAYPASS
  if (tool == "lftp")
    cmd = mask_after(cmd, "-u[ \t]+[^ \t,]+," arg, ",", 3, "")  # -u user,pass
  if (tool == "ncat")
    cmd = mask_after(cmd, "--proxy-auth[= \t]+" arg, ":", 0, "")
  return cmd
}
AWK

# clean_log <raw>: print the raw log as plain text
clean_log() {
  local raw="$1"
  [[ -s "$raw" ]] || return 0
  if command -v perl >/dev/null 2>&1; then
    perl -e "$CLEAN_PL" < "$raw"
  else
    # no perl: just strip escapes and drop \r and backspaces (cruder, doesn't apply overwrites)
    sed -E 's/\x1b\[[0-9;?]*[ -\/]*[@-~]//g; s/\x1b\][^\x07]*\x07//g; s/\x1b[()][A-Za-z0-9]//g; s/\x1b[=>]//g' "$raw" \
      | tr -d '\r' | sed 's/.\x08//g; s/\x08//g'
  fi
}

# build_log <box_dir> <name>: rebuild session-<name>.log from every raw session log,
# oldest first, each under a "===== session <start time> =====" header
build_log() {
  local dir="$1" name="$2" f b tmp
  local files=()
  if [[ -s "$dir/.session-$name.raw" ]]; then      # single-file layout from earlier versions
    files+=("$dir/.session-$name.raw")
  fi
  shopt -s nullglob
  for f in "$dir"/.sessions/*.raw; do
    if [[ -s "$f" ]]; then
      files+=("$f")
    fi
  done
  shopt -u nullglob
  [[ ${#files[@]} -gt 0 ]] || return 0

  tmp="$(mktemp)"
  for f in "${files[@]}"; do
    b="$(basename -- "$f" .raw)"
    if [[ "$b" =~ ^([0-9]{4})([0-9]{2})([0-9]{2})-([0-9]{2})([0-9]{2})([0-9]{2}) ]]; then
      printf '===== session %s-%s-%s %s:%s:%s =====\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" "${BASH_REMATCH[3]}" "${BASH_REMATCH[4]}" "${BASH_REMATCH[5]}" "${BASH_REMATCH[6]}"
    else
      printf '===== earlier session =====\n'
    fi
    clean_log "$f"
    echo
  done > "$tmp"
  chmod 600 "$tmp"                                  # it holds everything you typed, passwords included
  mv "$tmp" "$dir/session-$name.log"
}

# list_boxes: show every box (directory containing box.env) under the current directory
list_boxes() {
  local found=0 d n ip done_count
  printf '%-26s %-18s %s\n' "BOX" "TARGET" "PROOF"
  for d in "$PWD"/*/; do
    [[ -f "${d}box.env" ]] || continue
    found=1
    n="$(basename -- "$d")"
    # shellcheck source=/dev/null
    ip="$(. "${d}box.env"; echo "${IP:-}")"
    done_count="$(grep -cE '^- \[[xX]\] (local|proof)\.txt' "${d}notes/notes.md" 2>/dev/null || true)"
    printf '%-26s %-18s %s/2\n' "$n" "${ip:--}" "${done_count:-0}"
  done
  if [[ "$found" -eq 0 ]]; then
    echo "No boxes found in $PWD"
  fi
}

# files_by_mtime <dir> [find-args...]: relative file names under <dir>, oldest first
files_by_mtime() {
  local d="$1"; shift
  find "$d" -type f "$@" -printf '%T@\t%P\n' 2>/dev/null | sort -n | cut -f2-
}

# ordered_screenshots <screenshots_dir>: image names in the order they were taken. Screenshots saved
# with `shot` come first in captions.tsv order (the order they were captured); any other images
# follow, oldest first.
ordered_screenshots() {
  local d="$1" f
  local -A seen=()
  if [[ -f "$d/captions.tsv" ]]; then
    while IFS=$'\t' read -r f _; do
      if [[ -n "$f" && -f "$d/$f" && -z "${seen[$f]:-}" ]]; then
        seen[$f]=1
        printf '%s\n' "$f"
      fi
    done < "$d/captions.tsv"
  fi
  while IFS= read -r f; do
    if [[ -n "$f" && -z "${seen[$f]:-}" ]]; then
      printf '%s\n' "$f"
    fi
  done < <(files_by_mtime "$d" \( -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.gif' \))
}

# chrono_log <box_dir> <name>: markdown chronological log. Merges shell history (commands), timeline
# notes and screenshot captions by time. Commands run in a code block; notes and screenshots are
# bullets. Prints nothing if there is nothing to merge. Needs GNU date.
#   - trivial commands (ls, cd, pwd, clear, history, exit, note, shot, ...) are left out
#   - `addcred user:pass ...` is shown as `addcred user:***` so passwords never reach the report
chrono_log() {
  local dir="$1" name="$2" t hist tl cap
  hist="$dir/.bash_history_$name"
  tl="$dir/notes/timeline.md"
  cap="$dir/screenshots/captions.tsv"
  t="$(mktemp -d)"

  # commands: "<epoch>\tC\t<command>"  (multi-line commands are joined with \036)
  if [[ -s "$hist" ]]; then
    # $MASK_AWK supplies mask_cmd(), shared with the live timeline notes (see its comment above)
    awk -v tools="$MKBOX_NET_CMDS" "$MASK_AWK"'
      function flush() {
        if (cmd == "") return
        if (cmd ~ /^[ \t]*(ls|ll|la|cd|pwd|clear|history|exit|logout|boxinfo|boxcd|note|shot|cleanlog|proofcmd|report)([ \t]|$)/) { cmd = ""; return }
        if (match(cmd, /^addcred +[^: ]+:/)) cmd = substr(cmd, 1, RLENGTH) "***"
        cmd = mask_cmd(cmd)
        printf "%s\tC\t%s\n", ep, cmd
        cmd = ""
      }
      /^#[0-9]+$/ { flush(); ep = substr($0, 2); next }
      { if (ep == "") next; cmd = (cmd == "" ? $0 : cmd "\036" $0) }
      END { flush() }
    ' "$hist" > "$t/c.tsv" || true
  fi

  # timeline notes: "<epoch>\tN\t<text>"; screenshot lines are skipped (captions.tsv covers them)
  if [[ -s "$tl" ]]; then
    grep -E '^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}  ' "$tl" 2>/dev/null \
      | grep -vE '^.{21}screenshot ' > "$t/n.txt" || true
    if [[ -s "$t/n.txt" ]]; then
      cut -c1-19 "$t/n.txt" | date -f - +%s 2>/dev/null > "$t/n.ep" || true
      cut -c22- "$t/n.txt" > "$t/n.tx"
      if [[ "$(wc -l < "$t/n.ep")" -eq "$(wc -l < "$t/n.tx")" ]]; then
        paste -d '\t' "$t/n.ep" <(sed 's/^/N\t/' "$t/n.tx") > "$t/n.tsv"
      else
        echo "mkbox: WARNING: couldn't parse one or more timestamps in notes/timeline.md (GNU date required) - timeline notes left out of the report's chronological log; they're still in notes/timeline.md and the evidence tarball" >&2
      fi
    fi
  fi

  # screenshots: "<epoch>\tS\t<file>\t<caption>"
  if [[ -s "$cap" ]]; then
    cut -f2 "$cap" | date -f - +%s 2>/dev/null > "$t/s.ep" || true
    if [[ "$(wc -l < "$t/s.ep")" -eq "$(wc -l < "$cap")" ]]; then
      paste -d '\t' "$t/s.ep" <(awk -F'\t' '{printf "S\t%s\t%s\n", $1, $3}' "$cap") > "$t/s.tsv"
    else
      echo "mkbox: WARNING: couldn't parse one or more timestamps in screenshots/captions.tsv - screenshot captions left out of the report's chronological log; the images and captions are still in the Screenshots section and the evidence tarball" >&2
    fi
  fi

  cat "$t"/c.tsv "$t"/n.tsv "$t"/s.tsv 2>/dev/null | sort -s -t $'\t' -k1,1n > "$t/all.tsv" || true
  if [[ -s "$t/all.tsv" ]]; then
    sed 's/\t.*//; s/^/@/' "$t/all.tsv" | date -f - '+%F %T' 2>/dev/null > "$t/when.txt" || true
    if [[ "$(wc -l < "$t/when.txt")" -ne "$(wc -l < "$t/all.tsv")" ]]; then
      echo "mkbox: WARNING: couldn't re-format one or more merged timeline timestamps - the chronological log is incomplete for this run; re-run with \`mkbox -c\`/\`report\` after checking GNU date is installed" >&2
    fi
    if [[ "$(wc -l < "$t/when.txt")" -eq "$(wc -l < "$t/all.tsv")" ]]; then
      paste -d '\t' "$t/when.txt" "$t/all.tsv" | awk -F'\t' '
        function close_block() { if (inblock) { print "```"; print ""; inblock = 0 } }
        {
          when = $1; kind = $3
          text = $0; sub(/^[^\t]*\t[^\t]*\t[^\t]*\t/, "", text)
          if (kind == "C") {
            if (!inblock) { if (bullet) print ""; print "```"; inblock = 1; bullet = 0 }
            gsub(/\036/, "\n    ", text)
            printf "[%s] $ %s\n", when, text
          } else if (kind == "N") {
            close_block(); printf "- **%s** - %s\n", when, text; bullet = 1
          } else if (kind == "S") {
            close_block()
            n = index(text, "\t"); file = substr(text, 1, n - 1); c = substr(text, n + 1)
            printf "- **%s** - screenshot `%s`: %s\n", when, file, c; bullet = 1
          }
        }
        END { close_block() }'
    fi
  fi
  rm -rf "$t"
}

# md_filelist <dir>: markdown bullet list of files under <dir>, oldest first
md_filelist() {
  local out
  out="$(files_by_mtime "$1")"
  if [[ -n "$out" ]]; then
    printf '%s\n' "- ${out//$'\n'/$'\n'- }"
  else
    echo "_none_"
  fi
}

# _warn_secrets_keep <cred>: reads "file:lineno:content" (grep -n output) on stdin and re-prints
# only the lines that should count as a real leak, i.e. filters out the `addcred user:pass ...`
# line you typed, which is in the session log by design. That's normally just "does this line
# contain 'addcred '" - but on a narrow terminal, readline redraws a wrapped command across more
# than one screen row, and clean_log's line-based model can't follow that (see its header comment).
# The observed result is always the same shape: the credential itself (and anything after it)
# survives on its own physical line intact, with only some trailing suffix of the word "addcred"
# still attached before it - "ddcred bob:pass ...", "d bob:pass ...", or nothing at all. So a line
# also doesn't count if everything before the credential, once trimmed, is itself such a suffix.
_warn_secrets_keep() {
  local cred="$1" file lineno content before
  while IFS=: read -r file lineno content; do
    case "$content" in *'addcred '*) continue ;; esac
    before="${content%%"$cred"*}"
    before="${before%"${before##*[![:space:]]}"}"            # rtrim trailing whitespace
    case "addcred" in *"$before") continue ;; esac            # "", d, ed, red, cred, dcred, ddcred, addcred
    printf '%s:%s\n' "$file" "$lineno"
  done
}

# warn_secrets <box_dir> <path>...: warn if a password recorded in creds/creds.txt also appears in
# the given files or folders (relative to the box). Passwords under 4 characters are skipped. The
# `addcred user:pass` line you typed is in the session log by design, so it doesn't count (see
# _warn_secrets_keep); anything else (a note, a command, a pasted file) does.
warn_secrets() {
  local dir="$1"; shift
  local f="$dir/creds/creds.txt" line cred user pass hits
  [[ -s "$f" ]] || return 0
  while IFS= read -r line; do
    cred="$(awk '{print $3}' <<<"$line")"
    [[ "$cred" == *:* ]] || continue
    user="${cred%%:*}"
    pass="${cred#*:}"
    [[ ${#pass} -ge 4 ]] || continue
    # shellcheck disable=SC2015  # "A && B || true" is intended: a failed lookup must never abort the report
    hits="$(cd "$dir" && grep -rInHF -- "$pass" "$@" 2>/dev/null | _warn_secrets_keep "$cred" | cut -d: -f1 | sort -u | paste -sd, || true)"
    if [[ -n "$hits" ]]; then
      echo "WARNING: the password recorded for '$user' also appears in: $hits"
    fi
  done < "$f"
}

# make_report <box_dir> <name> <with_creds 0|1>
make_report() {
  local dir="$1" name="$2" with_creds="$3"
  local rdir="$dir/report" md ip f out cap
  [[ -f "$dir/box.env" ]] || { echo "mkbox: $dir is not a box (no box.env)" >&2; exit 1; }

  mkdir -p "$rdir"
  md="$rdir/$name-report.md"
  # shellcheck source=/dev/null
  ip="$(. "$dir/box.env"; echo "${IP:-}")"

  # make sure the cleaned log is current
  build_log "$dir" "$name"

  {
    echo "# $name - report draft"
    echo
    echo "- **Target:** ${ip:-unknown}"
    echo "- **Generated:** $(date '+%F %T')"
    echo
    echo "## Notes"
    echo
    sed '1{/^# /d}' "$dir/notes/notes.md"
    echo
    echo "## Timeline"
    echo
    out="$(chrono_log "$dir" "$name")"                        # commands + notes + screenshots, by time
    if [[ -n "$out" ]]; then
      printf '%s\n' "$out"
    elif [[ -s "$dir/notes/timeline.md" ]]; then
      printf '%s\n' '```'
      cat "$dir/notes/timeline.md"
      printf '%s\n' '```'
    else
      echo "_none_"
    fi
    echo
    echo "## Nmap results"
    echo
    out="$(files_by_mtime "$dir/nmap" -name '*.nmap')"       # oldest scan first
    if [[ -n "$out" ]]; then
      while IFS= read -r f; do
        echo "### $f"
        echo
        printf '%s\n' '```'
        cat "$dir/nmap/$f"
        printf '%s\n' '```'
        echo
      done <<<"$out"
    else
      echo "_none_"
      echo
    fi
    echo "## Screenshots"
    echo
    out="$(ordered_screenshots "$dir/screenshots")"          # in the order they were taken
    if [[ -n "$out" ]]; then
      while IFS= read -r f; do
        cap="$(awk -F'\t' -v f="$f" '$1==f {print $2 "  -  " $3; exit}' "$dir/screenshots/captions.tsv" 2>/dev/null || true)"
        echo "**$f**"
        echo
        echo "![$f](../screenshots/${f// /%20})"
        echo
        if [[ -n "$cap" ]]; then
          echo "_${cap}_"
          echo
        fi
      done <<<"$out"
    else
      echo "_none_"
      echo
    fi
    echo "## Exploits / scripts"
    echo
    md_filelist "$dir/exploits"
    echo
    echo "## Loot (filenames only)"
    echo
    md_filelist "$dir/loot"
    echo
    echo "## Credentials"
    echo
    if [[ "$with_creds" -eq 1 && -s "$dir/creds/creds.txt" ]]; then
      printf '%s\n' '```'
      cat "$dir/creds/creds.txt"
      printf '%s\n' '```'
    elif [[ -s "$dir/creds/creds.txt" ]]; then
      echo "_creds/creds.txt is not inlined here (re-run with \`mkbox -r --creds $name\` to include it). Anything you typed into notes or the terminal is still part of this report and bundle._"
    else
      echo "_none recorded_"
    fi
  } > "$md"
  chmod 600 "$md" 2>/dev/null || true

  # evidence tarball: only things that exist
  local items=() p
  for p in notes screenshots nmap exploits web "session-$name.log" "report/$name-report.md"; do
    if [[ -e "$dir/$p" ]]; then
      items+=("$p")
    fi
  done
  if [[ "$with_creds" -eq 1 && -d "$dir/creds" ]]; then
    items+=("creds")
  fi
  tar -czf "$rdir/$name-evidence.tar.gz" -C "$dir" "${items[@]}"
  chmod 600 "$rdir/$name-evidence.tar.gz" 2>/dev/null || true

  echo "Report draft: $md"
  echo "Evidence:     $rdir/$name-evidence.tar.gz"
  echo "Included in tarball: ${items[*]}"
  if [[ "$with_creds" -eq 0 ]]; then
    echo "Left out: the creds/ and loot/ folders (use --creds to include creds/)."
    echo "That only covers those folders. Notes, exploits and the session log are bundled as typed"
    echo "(the session log includes the addcred lines you typed, passwords and all)."
    warn_secrets "$dir" "${items[@]}"
  fi
}

MODE=run
NO_SHELL=0
WITH_CREDS=0
POSITIONAL=()
# Flags and the box name/IP can come in any order (mkbox lame -n, mkbox -n lame, ...); only the
# first two non-flag args are ever used (box name, then IP), so this doesn't need getopt-style
# option-argument handling.
while [[ $# -gt 0 ]]; do
  case "$1" in
    -n|--no-shell) NO_SHELL=1 ;;
    -c|--clean)    MODE=clean ;;
    -r|--report)   MODE=report ;;
    -l|--list)     MODE=list ;;
    -V|--version)  echo "mkbox $VERSION"; exit 0 ;;
    --creds)       WITH_CREDS=1 ;;
    -h|--help)     usage 0 ;;
    --)            shift; POSITIONAL+=("$@"); break ;;
    -*)            echo "mkbox: unknown option $1" >&2; usage 1 ;;
    *)             POSITIONAL+=("$1") ;;
  esac
  shift
done
set -- "${POSITIONAL[@]}"

if [[ "$MODE" == "list" ]]; then
  list_boxes
  exit 0
fi

TARGET="${1:-}"
IP="${2:-}"
[[ -n "$TARGET" ]] || usage 1

# Resolve the box directory relative to where mkbox was run
if [[ "$TARGET" == "." || "$TARGET" == */* ]]; then
  BOX_DIR="$(realpath -m -- "$TARGET")"
else
  BOX_DIR="$PWD/$TARGET"
fi
NAME="$(basename -- "$BOX_DIR")"

[[ "$NAME" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || { echo "mkbox: box name must start with a letter/digit and contain only letters, digits, . _ -  (got: $NAME)" >&2; exit 1; }
if [[ -n "$IP" && ! "$IP" =~ $IP_RE ]]; then
  echo "mkbox: that doesn't look like an IP/hostname: $IP" >&2
  exit 1
fi

LOG="$BOX_DIR/session-$NAME.log"

if [[ "$MODE" == "clean" ]]; then
  build_log "$BOX_DIR" "$NAME"
  [[ -f "$LOG" ]] || { echo "mkbox: no session logs found for $NAME" >&2; exit 1; }
  echo "Cleaned log: $LOG"
  exit 0
fi

if [[ "$MODE" == "report" ]]; then
  make_report "$BOX_DIR" "$NAME" "$WITH_CREDS"
  exit 0
fi

# New box or an existing one? (so a typo like `mkbox lmae` says it is creating something new)
if [[ -f "$BOX_DIR/box.env" ]]; then BOX_STATE=existing; else BOX_STATE=new; fi
if [[ ! -d "$BOX_DIR" ]]; then
  mkdir -p "$BOX_DIR"
  chmod 700 "$BOX_DIR" 2>/dev/null || true      # private by default: the logs hold everything you type
fi
for d in "${SUBDIRS[@]}"; do mkdir -p "$BOX_DIR/$d"; done

# --- keep the box out of git by default; never overwrite one the user replaced themselves ---
if [[ ! -e "$BOX_DIR/.gitignore" ]]; then
  printf '*\n' > "$BOX_DIR/.gitignore"
fi

# --- shared box state (IP, open ports) lives in box.env; every tab re-reads it at each prompt ---
CUR_IP="$(env_get "$BOX_DIR" IP)"
if [[ ! -f "$BOX_DIR/box.env" || ( -n "$IP" && "$IP" != "$CUR_IP" ) ]]; then
  write_env "$BOX_DIR" "${IP:-$CUR_IP}" "$(env_get "$BOX_DIR" PORTS)" "$(env_get "$BOX_DIR" UDP_PORTS)"
fi

# --- notes template (only created once, never overwritten) ---
if [[ ! -f "$BOX_DIR/notes/notes.md" ]]; then
  cat > "$BOX_DIR/notes/notes.md" <<EOF
# $NAME

- **Target:** ${IP:-TBD}
- **Started:** $(date '+%F %T')

## Ports / Services
| Port | Service | Version | Notes |
|------|---------|---------|-------|
|      |         |         |       |

## Foothold
-

## Privilege Escalation
-

## Creds / Users
-

## Proof
- [ ] local.txt:
- [ ] proof.txt:

## Rabbit holes (what I tried that didn't work)
-

## Lessons learned
- **Key vulnerability / technique:**
- **What I missed or got stuck on (and why):**
- **What I'd do faster next time:**
- **To practice / memorize:**
EOF
fi
touch "$BOX_DIR/notes/timeline.md"

# --- rc file for the logged shell (regenerated each run) ---
# Written to a temp file and renamed into place, so a tab starting at this exact moment never reads
# a half-written .box.rc.
RC_TMP="$(mktemp "$BOX_DIR/.box.rc.XXXXXX")"
trap 'rm -f "$RC_TMP"' EXIT
cat > "$RC_TMP" <<'EOF'
# Sourced by the mkbox shell
[ -f "$HOME/.bashrc" ] && . "$HOME/.bashrc"
. "$BOX_DIR/box.env"

# Per-box history with timestamps, written after every command
export HISTFILE="$BOX_DIR/.bash_history_$BOX"
export HISTTIMEFORMAT="%F %T "
export HISTSIZE=100000
export HISTFILESIZE=100000
export HISTCONTROL=ignorespace   # a leading space keeps a command out of history
shopt -s histappend

# Shared state: re-read box.env before every prompt, so an IP/ports change made in another tab
# (setip, portscan, udpscan) shows up here without restarting this shell. Only re-sourced when its
# mtime has actually changed, so a manual "IP=..." edit in this tab survives until something (this
# tab's own setip/portscan, or another tab) next rewrites box.env - see the README gotcha.
_BOXENV_SEEN=""
_boxsync() {
  local m
  [ -r "$BOX_DIR/box.env" ] || return 0
  m="$(date -r "$BOX_DIR/box.env" '+%s.%N' 2>/dev/null || true)"
  [ "$m" != "$_BOXENV_SEEN" ] || return 0
  . "$BOX_DIR/box.env"
  _BOXENV_SEEN="$m"
  return 0
}
_saveenv() {   # write IP / PORTS / UDP_PORTS to box.env atomically (temp file + rename)
  local t
  t="$(mktemp "$BOX_DIR/.box.env.XXXXXX")" || return 1
  printf 'export IP=%q\nexport PORTS=%q\nexport UDP_PORTS=%q\n' "${IP:-}" "${PORTS:-}" "${UDP_PORTS:-}" > "$t"
  chmod 644 "$t"
  mv -f "$t" "$BOX_DIR/box.env"
  _BOXENV_SEEN="$(date -r "$BOX_DIR/box.env" '+%s.%N' 2>/dev/null || true)"   # we already have these values; don't re-source our own write
}
# Appending ourselves is safe whether PROMPT_COMMAND is unset, a plain string, or (bash 5.1+) an
# array: `${PROMPT_COMMAND:+...}` only ever inspects/expands element 0 of an array, so a multi-element
# PROMPT_COMMAND array from .bashrc would otherwise silently lose everything past element 0. Converting
# to the array form here runs every existing entry (as bash itself does for a string) plus ours.
# Before bash 5.1 PROMPT_COMMAND can't be an array at all (bash would only ever run element 0), so
# there we append to the plain string instead.
if (( BASH_VERSINFO[0] > 5 || (BASH_VERSINFO[0] == 5 && BASH_VERSINFO[1] >= 1) )); then
  if ! declare -p PROMPT_COMMAND 2>/dev/null | grep -q '^declare -a'; then
    PROMPT_COMMAND=("${PROMPT_COMMAND:-}")
  fi
  PROMPT_COMMAND+=('history -a; _boxsync')
else
  # shellcheck disable=SC2178,SC2128  # intentional: before bash 5.1 it is only ever a plain string
  PROMPT_COMMAND="history -a; _boxsync${PROMPT_COMMAND:+; $PROMPT_COMMAND}"
fi

PS1="\[\e[1;31m\][box:$BOX]\[\e[0m\] ${PS1:-\u@\h:\w\$ }"

# ---------------------------------------------------------------- helpers
_sudo() { if [ "$(id -u)" -eq 0 ]; then "$@"; else sudo "$@"; fi; }
# _unroot <file>...: sudo nmap -oA writes its output files as root; hand them back to the user
# who's actually running the box shell (so they aren't stuck needing sudo just to read a scan).
#   - regular user (the normal Kali setup): chown them back with sudo. The nmap run just before has
#     the credentials cached, and -n means this can never hang on a password prompt.
#   - root shell started with `sudo -i` / `sudo su`: give them to $SUDO_USER.
# $SUDO_USER can't be used to detect the first case: sudo sets it only for the command it launches,
# never in your own shell.
_unroot() {
  if [ "$(id -u)" -eq 0 ]; then
    [ -n "${SUDO_USER:-}" ] || return 0
    chown "$SUDO_USER" "$@" 2>/dev/null || true
  else
    sudo -n chown "$(id -u):$(id -g)" "$@" 2>/dev/null || true
  fi
}

# --- notes & navigation
note()     { printf '%s  %s\n' "$(date '+%F %T')" "$*" >> "$BOX_DIR/notes/timeline.md"; }   # note "got creds for bob"
boxcd()    { cd "$BOX_DIR/${1:-}" || return; }                                               # boxcd nmap
boxinfo() {                                                                                  # status overview
  echo "Box:    $BOX"
  echo "Target: ${IP:-<unset>}"
  echo "Dir:    $BOX_DIR"
  [ -n "${PORTS:-}" ] && echo "Ports:  $PORTS"
  [ -n "${UDP_PORTS:-}" ] && echo "UDP:    $UDP_PORTS"
  printf 'Files:  '
  for d in nmap web loot exploits screenshots; do
    printf '%s=%s ' "$d" "$(find "$BOX_DIR/$d" -type f 2>/dev/null | wc -l)"
  done
  echo
  echo "Proof:"
  grep -E '^- \[.\] (local|proof)\.txt' "$BOX_DIR/notes/notes.md" | sed 's/^/  /'
  echo "Recent timeline:"
  tail -n 5 "$BOX_DIR/notes/timeline.md" | sed 's/^/  /'
}
setip() {                                                                                    # setip 10.10.10.4 (after a machine revert)
  [ -n "${1:-}" ] || { echo "usage: setip <ip>"; return 1; }
  if ! [[ "$1" =~ $MKBOX_IP_RE ]]; then                    # same check mkbox itself applies
    echo "setip: that doesn't look like an IP/hostname: $1"
    return 1
  fi
  _boxsync
  IP="$1"; export IP
  _saveenv                                                 # other tabs pick this up at their next prompt
  sed -i "s|^- \\*\\*Target:\\*\\* .*|- **Target:** $IP|" "$BOX_DIR/notes/notes.md"   # keep the notes header in sync
  note "target IP set to $IP"
  echo "IP=$IP"
}

# --- recon wrappers (plain nmap with fixed flags; output goes to nmap/)
# _archive_scan <name>: before a scan overwrites nmap/<name>.*, keep the previous results as
# <name>-<time of that scan>.<ext>, so a re-run (e.g. after a machine revert) loses nothing
_archive_scan() {
  local ext f stamp
  for ext in nmap gnmap xml; do
    f="$BOX_DIR/nmap/$1.$ext"
    if [ -f "$f" ]; then
      stamp="$(date -r "$f" '+%Y%m%d-%H%M%S')"
      mv -f "$f" "$BOX_DIR/nmap/$1-$stamp.$ext"
    fi
  done
}
portscan() {                                                                                 # all TCP ports -> nmap/allports.*, sets $PORTS
  [ -n "${IP:-}" ] || { echo "IP not set (use: setip <ip>)"; return 1; }
  _archive_scan allports
  _sudo nmap -p- --min-rate 2000 -T4 -oA "$BOX_DIR/nmap/allports" "$IP" || return
  _unroot "$BOX_DIR/nmap/allports".{nmap,gnmap,xml}
  local found
  found="$(grep -oE '[0-9]+/open/tcp' "$BOX_DIR/nmap/allports.gnmap" | cut -d/ -f1 | sort -un | paste -sd,)"
  _boxsync; PORTS="$found"; export PORTS; _saveenv         # shared with the other tabs
  note "portscan: open ports ${PORTS:-none}"
  echo "Open ports: ${PORTS:-none}"
}
udpscan() {                                                                                  # udpscan [N] -> top-N UDP ports + version detection
  local n="${1:-20}" found maybe
  case "$n" in ''|*[!0-9]*) echo "usage: udpscan [number-of-top-ports]"; return 1 ;; esac
  [ -n "${IP:-}" ] || { echo "IP not set (use: setip <ip>)"; return 1; }
  echo "UDP scans are slow (minutes). Consider running this in a second tab."
  _archive_scan udp
  _sudo nmap -sU -sV --top-ports "$n" --open -oA "$BOX_DIR/nmap/udp" "$IP" || return
  _unroot "$BOX_DIR/nmap/udp".{nmap,gnmap,xml}
  found="$(grep -oE '[0-9]+/open/udp' "$BOX_DIR/nmap/udp.gnmap" | cut -d/ -f1 | sort -un | paste -sd,)"
  maybe="$(grep -oE '[0-9]+/open\|filtered/udp' "$BOX_DIR/nmap/udp.gnmap" | cut -d/ -f1 | sort -un | paste -sd,)"
  _boxsync; UDP_PORTS="$found"; export UDP_PORTS; _saveenv
  note "udpscan top $n: open UDP ports ${UDP_PORTS:-none}${maybe:+ (open|filtered: $maybe)}"
  echo "Open UDP ports: ${UDP_PORTS:-none}"
  [ -n "$maybe" ] && echo "open|filtered (not stored in \$UDP_PORTS; check nmap/udp.nmap): $maybe"
  return 0
}
svcscan() {                                                                                  # svcscan [ports] -> default scripts + versions
  local p="${1:-${PORTS:-}}"
  [ -n "${IP:-}" ] || { echo "IP not set (use: setip <ip>)"; return 1; }
  [ -n "$p" ] || { echo "no ports: run portscan first, or: svcscan 22,80"; return 1; }
  case "$p" in *[!0-9,-]*) echo "svcscan: ports must be numbers or ranges separated by commas (got: $p)"; return 1 ;; esac
  _archive_scan services
  _sudo nmap -sC -sV -p "$p" -oA "$BOX_DIR/nmap/services" "$IP" && { _unroot "$BOX_DIR/nmap/services".{nmap,gnmap,xml}; note "svcscan on ports $p"; }
}

# --- screenshots (from the clipboard)
shot() {                                                                                     # shot "what this shows" -> saves the clipboard image
  local msg="${*:-screenshot}" ts slug f n=1 tmp
  msg="${msg//$'\t'/ }"
  ts="$(date '+%Y%m%d-%H%M%S')"
  slug="$(printf '%s' "$msg" | tr '[:upper:]' '[:lower:]' | tr -cs 'a-z0-9' '-' | sed 's/^-//; s/-$//' | cut -c1-40)"
  f="$ts-${slug:-screenshot}.png"
  while [ -e "$BOX_DIR/screenshots/$f" ]; do n=$((n+1)); f="$ts-${slug:-screenshot}-$n.png"; done
  tmp="$(mktemp)"
  if [ -n "${WAYLAND_DISPLAY:-}" ] && command -v wl-paste >/dev/null 2>&1; then
    wl-paste --type image/png > "$tmp" 2>/dev/null
  elif command -v xclip >/dev/null 2>&1; then
    xclip -selection clipboard -t image/png -o > "$tmp" 2>/dev/null
  else
    rm -f "$tmp"; echo "shot: need xclip (X11) or wl-clipboard (Wayland):  sudo apt install xclip"; return 1
  fi
  if [ "$(head -c 8 "$tmp" 2>/dev/null | od -An -tx1 | tr -d ' \n')" != "89504e470d0a1a0a" ]; then
    rm -f "$tmp"; echo "shot: no PNG image on the clipboard (copy the screenshot first)"; return 1
  fi
  chmod 644 "$tmp"
  mv "$tmp" "$BOX_DIR/screenshots/$f"
  printf '%s\t%s\t%s\n' "$f" "$(date '+%F %T')" "$msg" >> "$BOX_DIR/screenshots/captions.tsv"
  note "screenshot $f - $msg"
  echo "saved screenshots/$f"
}

# --- file transfer
serve() {                                                                      # serve [--bind <ip>] [port]  (serves transfer/; sudo for ports below 1024)
  local bind="" port="80" args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --bind) bind="${2:-}"; shift 2 ;;
      --bind=*) bind="${1#--bind=}"; shift ;;
      *) port="$1"; shift ;;
    esac
  done
  case "$port" in ''|*[!0-9]*) echo "usage: serve [--bind <ip>] [port]"; return 1 ;; esac
  # Default (no --bind): python's http.server listens on every interface, so transfer/ is reachable
  # from anywhere on your network, not just the target. Pass --bind <your-vpn-ip> (e.g. tun0) to
  # restrict it, or --bind 127.0.0.1 if you're only serving over a tunnel/port-forward.
  [ -n "$bind" ] && args+=(--bind "$bind")
  if [ "$port" -lt 1024 ] && [ "$(id -u)" -ne 0 ]; then
    ( cd "$BOX_DIR/transfer" && sudo python3 -m http.server "${args[@]}" "$port" )
  else
    ( cd "$BOX_DIR/transfer" && python3 -m http.server "${args[@]}" "$port" )
  fi
}

# --- remote/transfer session logging -------------------------------------------------------
# Connecting out (ssh, ftp, rdp, ...) is one of the most report-relevant things you do, so the
# commands in $MKBOX_NET_CMDS get a timestamped start/end timeline note - same idea as portscan.
#
# This is pure passthrough, NOT a pty wrapper: `command "$name" "$@"` runs the real binary directly
# in the foreground. Your terminal's stdin/stdout/stderr, job control, Ctrl-C, window resizes, and
# the real exit code all reach it exactly as if you'd typed it without mkbox - nothing is piped,
# backgrounded, or re-parented, so full-screen programs (vim or a shell over ssh), password
# prompts, and `scp`/`sftp` progress bars behave normally. A wrapper is only installed for a name
# if that binary is actually on PATH, so nothing is ever shadowed by a "command not found".
#
# Known, documented gaps (same spirit as addcred/warn_secrets - see README):
#   - sudo bypasses the wrapper (sudo resolves the real binary via PATH, not shell functions), so
#     `sudo nc ...` is logged by history like any other command but not start/end-timestamped.
#   - To run the real binary once without the wrapper: `command ssh ...` or `\ssh ...`.
#   - To add more tools, add their names to MKBOX_NET_CMDS (or set it in your own ~/.bashrc, which
#     loads before this file, and it will be respected). Set it in the environment you run mkbox
#     from if you also want the report's command timeline to mask passwords for those tools.
#   - In a pipeline (`ssh host cmd | tee out`), $? after the pipeline is bash's normal pipeline
#     status, same as without the wrapper.
# (MKBOX_NET_CMDS itself is set and exported by mkbox before this shell starts.)

# _netmask <tool> <args...>: the command line with passwords masked, for the timeline note only (the
# raw session log always has the real command - see Caveats). It uses the same mask_cmd() as the
# report (appended below as $MKBOX_MASK_AWK), so the two can't disagree. A password typed at an
# interactive prompt was never on the command line, so there is nothing to mask.
_netmask() {
  local masked
  masked="$(printf '%s\n' "$*" | awk -v tools="$MKBOX_NET_CMDS" "$MKBOX_MASK_AWK"$'\n''{ print mask_cmd($0) }')"
  printf '%s' "${masked#"$1" }"
}
_netlog() {
  local name="$1"; shift
  local start end dur rc shown
  shown="$(_netmask "$name" "$@")"
  note "$name: started${shown:+ ($shown)}"
  start=$(date +%s)
  command "$name" "$@"
  rc=$?
  end=$(date +%s); dur=$((end - start))
  note "$name: ended (exit $rc, ${dur}s)"
  return $rc
}
for _mkbox_netcmd in $MKBOX_NET_CMDS; do
  if command -v "$_mkbox_netcmd" >/dev/null 2>&1; then
    eval "$_mkbox_netcmd() { _netlog '$_mkbox_netcmd' \"\$@\"; }"
  fi
done
unset _mkbox_netcmd

# --- creds & proof
addcred() {                                                                                  # addcred user:pass [where found]
  [ $# -ge 1 ] || { echo 'usage: addcred user:pass [where found / service]'; return 1; }
  local f="$BOX_DIR/creds/creds.txt" c="$1"; shift
  [ -f "$f" ] || ( umask 077; : > "$f" )
  printf '%s  %s  (%s)\n' "$(date '+%F %T')" "$c" "${*:-no source noted}" >> "$f"
  note "cred recorded for ${c%%:*} (${*:-no source noted})"      # timeline gets the username only, never the password
}
proofcmd() {                                                                                 # prints proof one-liners to paste on the target
  cat <<'P'
Linux:    cat /root/proof.txt; whoami; hostname; ip a
          cat /home/<user>/local.txt; whoami; hostname; ip a
Windows:  type C:\Users\Administrator\Desktop\proof.txt & whoami & hostname & ipconfig
P
}

# --- logs & reporting
cleanlog() { "$MKBOX_BIN" -c "$BOX_DIR"; }                                                   # refresh the cleaned log mid-session
report()   { "$MKBOX_BIN" -r "$@" "$BOX_DIR"; }                                              # report [--creds]

echo "Box:    $BOX"
echo "Target: \$IP=${IP:-<unset>}"
echo "Dir:    $BOX_DIR"
echo "Helpers: note shot boxinfo boxcd setip portscan udpscan svcscan serve addcred proofcmd cleanlog report"
echo "Logged on connect/exit: $MKBOX_NET_CMDS"
EOF
# the masking program is shared with the report (see MASK_AWK above); %q makes it safe to source
printf 'MKBOX_MASK_AWK=%q\n' "$MASK_AWK" >> "$RC_TMP"
chmod 644 "$RC_TMP"
mv -f "$RC_TMP" "$BOX_DIR/.box.rc"

MKBOX_BIN="$(readlink -f -- "$0")"
export BOX="$NAME" BOX_DIR MKBOX_BIN MKBOX_IP_RE="$IP_RE"

if [[ "$NO_SHELL" -eq 1 ]]; then
  if [[ "$BOX_STATE" == new ]]; then
    echo "Created $BOX_DIR"
  else
    echo "Box already exists, updated: $BOX_DIR"
  fi
  exit 0
fi

if ! command -v script >/dev/null 2>&1; then
  echo "mkbox: 'script' not found - install util-linux (or use -n to set up the box without a shell)" >&2
  exit 1
fi

if [[ "$BOX_STATE" == new ]]; then
  echo "mkbox: creating new box '$NAME' in $(dirname -- "$BOX_DIR")${IP:+ (target $IP)}"
  [[ -n "$IP" ]] || echo "mkbox: no target IP given - set one inside the box with: setip <ip>"
else
  echo "mkbox: re-entering '$NAME'"
fi

cd "$BOX_DIR"
printf -v SHELL_CMD 'bash --rcfile %q -i' "$BOX_DIR/.box.rc"

# One raw log per invocation, so a second tab on the same box never writes into this one.
mkdir -p "$BOX_DIR/.sessions"
chmod 700 "$BOX_DIR/.sessions" 2>/dev/null || true
RAW="$BOX_DIR/.sessions/$(date '+%Y%m%d-%H%M%S')-$$.raw"
( umask 077; : > "$RAW" )          # script keeps an existing file's mode, so the raw log stays private

# script -f flushes after every write (safe if the VM/laptop dies), -q hides the banner.
# Not exec'd: we need to regain control afterwards to clean the log.
set +e
script -q -f "$RAW" -c "$SHELL_CMD"
set -e

build_log "$BOX_DIR" "$NAME"
echo "Session log: $LOG"
